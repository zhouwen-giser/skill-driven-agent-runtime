name: sdar-verify-ab5dac33-be69-4fde-84d1-97eaabe74536-e2e-performance
services:
  postgres:
    build:
      context: /home/sz/code/skill-driven-agent-runtime-inspect-area-v1
      dockerfile: infra/postgres/Dockerfile.pgvector-hardened
      args:
        SOURCE_DATE_EPOCH: "0"
      provenance: "false"
      sbom: "false"
    environment:
      POSTGRES_DB: sdar
      POSTGRES_PASSWORD: sdar_local_only
      POSTGRES_USER: sdar
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U "$${POSTGRES_USER}" -d "$${POSTGRES_DB}"
      timeout: 3s
      interval: 2s
      retries: 30
      start_period: 5s
    image: sdar/postgres-pgvector:17.10-0.8.5-alpine3.23
    networks:
      sdar-local: null
    platform: linux/amd64
    ports:
      - mode: ingress
        host_ip: 127.0.0.1
        target: 5432
        published: "40885"
        protocol: tcp
    pull_policy: never
    restart: "no"
    volumes:
      - type: tmpfs
        target: /var/lib/postgresql/data
        tmpfs:
          size: "2147483648"
      - type: bind
        source: /home/sz/code/skill-driven-agent-runtime-inspect-area-v1/infra/postgres/baseline/0001_sdar_v1_2_2_baseline.sql
        target: /docker-entrypoint-initdb.d/0001_sdar_v1_2_2_baseline.sql
        read_only: true
        bind: {}
      - type: bind
        source: /home/sz/code/skill-driven-agent-runtime-inspect-area-v1/infra/postgres/seed/0001_sdar_v1_2_2_minimal_seed.sql
        target: /docker-entrypoint-initdb.d/0002_sdar_v1_2_2_minimal_seed.sql
        read_only: true
        bind: {}
  redis:
    command:
      - redis-server
      - --appendonly
      - "yes"
      - --appendfsync
      - everysec
      - --save
      - "60"
      - "1"
    healthcheck:
      test:
        - CMD
        - redis-cli
        - ping
      timeout: 3s
      interval: 2s
      retries: 30
      start_period: 2s
    image: redis@sha256:8096655e437712b07503796fb64d81359256cfcff0ab29d95a7da72863786efb
    networks:
      sdar-local: null
    platform: linux/amd64
    ports:
      - mode: ingress
        host_ip: 127.0.0.1
        target: 6379
        published: "39457"
        protocol: tcp
    restart: "no"
    volumes:
      - type: volume
        source: sdar-redis-data
        target: /data
        volume: {}
