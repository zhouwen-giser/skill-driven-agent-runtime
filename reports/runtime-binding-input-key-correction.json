  "implementation": {
    "authority": "Recompute eligible keys from PostgreSQL accepted detailed Provider observations and link/attempt history for the exact binding. No process-lifetime accepted-state cache. Original raw Task snapshots and same-key content guard are unchanged.",
    "closure": "ACK, uncertain/pre-wire reservation, existing provider_advanced status, actual recorded attempt, or accepted detailed removal/non-input state closes the key. Rejected identity, local failure/admission evidence, and basic input_required without request details do not establish supersession.",
    "openReplacement": "Waiting/answered unsent old links do not close keys. Activation checks current event.runtime_revision under the binding lock, cancels only an obsolete waiting local task_input_request, and leaves that old link status unchanged. The current link may send still-open same-content keys.",
    "dispatch": "claimUpdate atomically marks link update_uncertain and binding polling/nextPollAt with version+1 before transport. It returns eligible requests and the actual reserved binding version. Zero eligible keys never send and never yield a fabricated Ack. Restart uses reads, never an uncertain tasks/update replay.",
    "outcome": "Actual wire outcome and attempt persist before exact reserved-version binding CAS; a later accepted observation may win the binding CAS without reopening the acknowledged key.",
    "activation": "Two-line task.input_required branch in existing claimControl avoids an inappropriate terminal-state mutation; terminal-state mismatch and absent-continuation guards remain.",
    "schemaChanges": false,
    "liveProfileChanges": false
  },
  "interfaces": {
    "RemoteTaskInputRepository.findEligibleRequests": "(bindingId, requests) -> eligible request map; advisory read, rechecked under binding lock for activation/dispatch",
    "RemoteTaskInputRepository.claimUpdate": "({inputRequestId,expectedBindingVersion,startedAt}) -> {inputRequests,expectedBindingVersion:reservedVersion} | undefined; durable uncertainty and polling before wire",
    "RemoteTaskInputService.continuations": "Consumes existing claimControl and finishControl; closed-only control is processed without exposing an input or sending a request"
  },
