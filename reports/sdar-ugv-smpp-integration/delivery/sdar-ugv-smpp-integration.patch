+  expectedStatus = 202,
+  ifMatch?: string,
+): Promise<unknown> {
+  return responseJson(
+    await controlResponse(
+      configuration,
+      path,
+      {
+        method: 'POST',
+        headers: {
+          'content-type': 'application/json',
+          'idempotency-key': idempotencyKey,
+          ...(ifMatch === undefined ? {} : { 'if-match': ifMatch }),
+        },
+        body: JSON.stringify(body),
