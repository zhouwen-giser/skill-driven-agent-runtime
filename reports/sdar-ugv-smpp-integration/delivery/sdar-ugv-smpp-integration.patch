+    !['http:', 'https:'].includes(endpoint.protocol) ||
+    endpoint.username !== '' ||
+    endpoint.password !== '' ||
+    (!unsafeTestOpen && endpoint.protocol !== 'https:' && !loopback)
+  )
+    throw new Error('NODE_CONTROL_ENDPOINT_NOT_ALLOWED');
+  return endpoint.toString().replace(/\/+$/u, '');
