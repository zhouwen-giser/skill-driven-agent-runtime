+function visit(value: unknown, callback: (key: string, item: unknown) => void, key = ''): void {
+  callback(key, value);
+  if (Array.isArray(value)) {
+    value.forEach((item) => {
+      visit(item, callback);
+    });
+    return;
+  }
+  const record = object(value);
+  if (record !== undefined)
+    Object.entries(record).forEach(([nestedKey, item]) => {
+      visit(item, callback, nestedKey);
+    });
