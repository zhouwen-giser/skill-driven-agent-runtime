+const TraceSchema = z
+  .object({
+    instance: z
+      .object({
+        instanceId: z.string().min(1),
+        planId: z.string().min(1),
+        goalId: z.string().min(1),
+        goalVersion: z.number().int().positive(),
+        skillVersions: z.array(
+          z.object({ skillId: z.string().min(1), version: z.number().int().positive() }),
+        ),
