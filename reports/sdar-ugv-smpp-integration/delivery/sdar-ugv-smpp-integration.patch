+  if ((inline === undefined) === (file === undefined))
+    fail('UGV_A2A_CONFIGURATION_INVALID', `Set exactly one of ${name} or ${name}_FILE.`);
+  const value = (inline ?? (file === undefined ? '' : await readFile(file, 'utf8'))).trim();
