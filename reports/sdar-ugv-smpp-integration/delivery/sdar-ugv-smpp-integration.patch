+  .strict();
+
+const DiscoverySchema = z
+  .object({
+    protocolVersion: z.string().min(1),
+    serverInfo: z.record(z.string(), z.unknown()),
+    discoveredAt: z.iso.datetime(),
+    validUntil: z.iso.datetime(),
+    toolRevision: z.number().int().positive(),
