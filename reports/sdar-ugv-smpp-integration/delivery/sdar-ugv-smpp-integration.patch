+    model: provider.model,
+    apiStyle: provider.apiStyle,
+    connectivity: 'passed' as const,
+    credentialsRedacted: true as const,
+  });
+}
+
+function parseTimestamp(value: string): string {
+  return z.iso.datetime({ offset: true }).parse(value);
