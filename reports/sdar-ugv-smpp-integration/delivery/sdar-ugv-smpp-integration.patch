+        : [];
+    const resourceId = isRecord(value) ? value['resourceId'] : undefined;
+    return typeof resourceId === 'string' && allowed.includes(resourceId)
+      ? { valid: true, errors: [] }
+      : {
+          valid: false,
+          errors: [
