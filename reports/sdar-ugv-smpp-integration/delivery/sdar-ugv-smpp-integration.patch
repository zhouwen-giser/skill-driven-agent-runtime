+    (input.pollIntervalMs !== undefined &&
+      (input.pollIntervalMs < 0 || input.pollIntervalMs > 60_000)) ||
+    (input.maxPolls !== undefined &&
+      (!Number.isInteger(input.maxPolls) || input.maxPolls < 1 || input.maxPolls > 3_600))
