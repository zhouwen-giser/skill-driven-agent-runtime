+  .loose();
+
+const RuntimeServerSchema = z
+  .object({
+    serverId: z.string().min(1),
+    name: z.string().min(1),
+    endpoint: z.string().min(1),
+    protocolMode: z.literal('frozen_v1'),
+    toolRevision: z.number().int().positive(),
+    currentDiscovery: DiscoverySchema.optional(),
