[
  {
    "toolName": "vehicle_get_state",
    "inputSchema": {
      "type": "object",
      "required": ["resourceId"],
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "enum": ["chassis", "payload", "health", "targets"],
            "type": "string"
          },
          "uniqueItems": true
        },
        "resourceId": {
          "type": "string",
          "const": "vehicle:ugv"
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "anyOf": [
        {
          "type": "object",
          "title": "VehicleStateV1",
          "required": [
            "identity",
            "connectivity",
            "freshness",
            "revision",
            "observedAt",
            "mqttIngressSequence"
          ],
          "properties": {
            "health": {
              "type": "object",
              "additionalProperties": true
            },
            "chassis": {
              "type": "object",
              "additionalProperties": true
            },
            "payload": {
              "type": "object",
              "additionalProperties": true
            },
            "targets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "identity": {
              "type": "object",
              "required": ["providerId", "resourceId", "vehicleType", "executionMode"],
              "properties": {
                "providerId": {
                  "type": "string",
                  "minLength": 1
                },
                "resourceId": {
                  "type": "string",
                  "const": "vehicle:ugv"
                },
                "vehicleType": {
                  "type": "string",
                  "minLength": 1
                },
                "executionMode": {
                  "enum": ["simulation", "live"],
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "freshness": {
              "type": "object",
              "properties": {
                "healthObservedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "targetObservedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "chassisObservedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "missionObservedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "payloadObservedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "positionObservedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "additionalProperties": false
            },
            "observedAt": {
              "type": "string",
              "format": "date-time"
            },
            "connectivity": {
              "type": "object",
              "required": ["mqttConnected", "deviceMcpConnected"],
              "properties": {
                "mqttConnected": {
                  "type": "boolean"
                },
                "packetLossRate": {
                  "type": "number",
                  "minimum": 0
                },
                "deviceAvailable": {
                  "type": "boolean"
                },
                "deviceMcpConnected": {
                  "type": "boolean"
                },
                "averageRoundTripTimeMs": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "mqttIngressSequence": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["outcome", "reasonCode", "retryable", "completedAt"],
          "properties": {
            "outcome": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            },
            "reasonCode": {
              "type": "string",
              "minLength": 1
            },
            "completedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "executionSemantics": {
      "effect": "read_only",
      "execution": "synchronous",
      "cancellation": "unsupported",
      "idempotency": "server_managed",
      "replay": "allowed",
      "source": "admin_override"
    },
    "taskExecutionProfile": {
      "profileVersion": "1.0",
      "taskBehavior": "synchronous_only",
      "availability": "dynamic",
      "supportsScheduling": false,
      "supportsMaxElapsed": false,
      "supportsCancellation": false,
      "supportsPauseResume": false,
      "supportsObservations": false,
      "supportsInputRequired": false,
      "idempotency": "server_managed"
    }
  },
  {
    "toolName": "vehicle_navigate",
    "inputSchema": {
      "type": "object",
      "required": ["resourceId", "mission"],
      "properties": {
        "density": {
          "enum": ["adaptive", "dense", "medium", "sparse"],
          "type": "string"
        },
        "mission": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type", "target"],
              "properties": {
                "type": {
                  "const": "point"
                },
                "target": {
                  "type": "object",
                  "required": ["latitude", "longitude"],
                  "properties": {
                    "altitude": {
                      "type": "number"
                    },
                    "latitude": {
                      "type": "number",
                      "maximum": 90,
                      "minimum": -90
                    },
                    "longitude": {
                      "type": "number",
                      "maximum": 180,
                      "minimum": -180
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["type", "waypoints"],
              "properties": {
                "type": {
                  "const": "route"
                },
                "waypoints": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["latitude", "longitude"],
                    "properties": {
                      "altitude": {
                        "type": "number"
                      },
                      "latitude": {
                        "type": "number",
                        "maximum": 90,
                        "minimum": -90
                      },
                      "longitude": {
                        "type": "number",
                        "maximum": 180,
                        "minimum": -180
                      }
                    },
                    "additionalProperties": false
                  },
                  "maxItems": 1024,
                  "minItems": 1
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["type", "direction", "distanceM"],
              "properties": {
                "type": {
                  "const": "distance"
                },
                "direction": {
                  "enum": ["forward", "backward", "left", "right"],
                  "type": "string"
                },
                "distanceM": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {
                  "const": "return_home"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "resourceId": {
          "type": "string",
          "const": "vehicle:ugv"
        },
        "planningMode": {
          "enum": ["auto", "road_network", "direct"],
          "type": "string"
        },
        "speedLimitKmh": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "stopOnObstacle": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "anyOf": [
        {
          "type": "object",
          "title": "VehicleTaskResultV1",
          "required": ["resourceId", "status", "observedAt"],
          "properties": {
            "status": {
              "enum": ["completed", "failed", "cancelled", "timeout"],
              "type": "string"
            },
            "missionId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "observedAt": {
              "type": "string",
              "format": "date-time"
            },
            "resourceId": {
              "type": "string",
              "const": "vehicle:ugv"
            },
            "endPosition": {
              "type": "object",
              "additionalProperties": true
            },
            "missionState": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ]
            },
            "finalSpeedKmh": {
              "type": "number",
              "minimum": 0
            },
            "startPosition": {
              "type": "object",
              "additionalProperties": true
            },
            "finalHeadingDeg": {
              "type": "number"
            },
            "snapshotRevision": {
              "type": "string"
            },
            "positionAuthority": {
              "type": "object",
              "required": ["field", "topic", "observedAt", "timeAuthority", "cursor"],
              "properties": {
                "field": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "topic": {
                  "type": "string"
                },
                "cursor": {
                  "type": "string"
                },
                "observedAt": {
                  "type": "string"
                },
                "timeAuthority": {
                  "enum": ["source", "ingest"],
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "requestedDistanceM": {
              "type": "number",
              "minimum": 0
            },
            "correlationStrength": {
              "enum": ["STRICT_CORRELATED", "WEAK_UNCORRELATED", "MISMATCH", "UNKNOWN"],
              "type": "string"
            },
            "observationAuthority": {
              "type": "string"
            },
            "observedDisplacementM": {
              "type": "number",
              "minimum": 0
            },
            "stationaryAtCompletion": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "displacementUnavailableReason": {
              "enum": ["POSITION_AUTHORITY_MISMATCH"],
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["outcome", "reasonCode", "retryable", "completedAt"],
          "properties": {
            "outcome": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            },
            "reasonCode": {
              "type": "string",
              "minLength": 1
            },
            "completedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "executionSemantics": {
      "effect": "side_effecting",
      "execution": "task_required",
      "cancellation": "task_cancel",
      "idempotency": "server_managed",
      "replay": "forbidden",
      "source": "admin_override"
    },
    "taskExecutionProfile": {
      "profileVersion": "1.0",
      "taskBehavior": "task_required",
      "availability": "dynamic",
      "supportsScheduling": true,
      "supportsMaxElapsed": true,
      "supportsCancellation": true,
      "supportsPauseResume": true,
      "supportsObservations": true,
      "supportsInputRequired": false,
      "idempotency": "server_managed"
    }
  }
]
