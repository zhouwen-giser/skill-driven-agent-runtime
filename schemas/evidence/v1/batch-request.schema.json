{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdar.local/evidence/v1/batch-request.schema.json",
  "title": "sdar.evidence/v1 batch request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "exportId",
    "sourceId",
    "nodeId",
    "revision",
    "firstSequence",
    "lastSequence",
    "batchHash",
    "records"
  ],
  "properties": {
    "contractVersion": { "const": "sdar.evidence/v1" },
    "exportId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sourceId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "nodeId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "revision": { "type": "integer", "minimum": 1 },
    "firstSequence": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "lastSequence": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "batchHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "oneOf": [
          { "$ref": "records/runtime.episode.schema.json" },
          { "$ref": "records/runtime.request.schema.json" },
          { "$ref": "records/runtime.a2a_task.schema.json" },
          { "$ref": "records/runtime.goal.schema.json" },
          { "$ref": "records/runtime.goal_contract.schema.json" },
          { "$ref": "records/runtime.goal_patch.schema.json" },
          { "$ref": "records/runtime.plan.schema.json" },
          { "$ref": "records/runtime.plan_step.schema.json" },
          { "$ref": "records/runtime.state_transition.schema.json" },
          { "$ref": "records/runtime.decision.schema.json" },
          { "$ref": "records/runtime.policy_decision.schema.json" },
          { "$ref": "records/runtime.execution_gate.schema.json" },
          { "$ref": "records/runtime.human_confirmation.schema.json" },
          { "$ref": "records/runtime.action.schema.json" },
          { "$ref": "records/runtime.receipt.schema.json" },
          { "$ref": "records/runtime.verification.schema.json" },
          { "$ref": "records/runtime.outcome.schema.json" },
          { "$ref": "records/runtime.run_seal.schema.json" },
          { "$ref": "records/skill.usage_snapshot.schema.json" },
          { "$ref": "records/skill.candidate.schema.json" },
          { "$ref": "records/skill.applicability.schema.json" },
          { "$ref": "records/skill.context_resolution.schema.json" },
          { "$ref": "records/skill.selection.schema.json" },
          { "$ref": "records/skill.mode_selection.schema.json" },
          { "$ref": "records/skill.composition.schema.json" },
          { "$ref": "records/skill.composition_edge.schema.json" },
          { "$ref": "records/skill.capability_slot_resolution.schema.json" },
          { "$ref": "records/skill.procedure_compilation.schema.json" },
          { "$ref": "records/skill.plan_compliance.schema.json" },
          { "$ref": "records/skill.execution.schema.json" },
          { "$ref": "records/skill.execution_event.schema.json" },
          { "$ref": "records/skill.execution_reference.schema.json" },
          { "$ref": "records/skill.failure_propagation.schema.json" },
          { "$ref": "records/skill.evidence_requirement.schema.json" },
          { "$ref": "records/mcp_task.tool_call.schema.json" },
          { "$ref": "records/mcp_task.availability.schema.json" },
          { "$ref": "records/mcp_task.remote_binding.schema.json" },
          { "$ref": "records/mcp_task.logical_invocation.schema.json" },
          { "$ref": "records/mcp_task.admission.schema.json" },
          { "$ref": "records/mcp_task.dispatch_uncertain.schema.json" },
          { "$ref": "records/mcp_task.dispatch_reconciliation.schema.json" },
          { "$ref": "records/mcp_task.provider_execution_link.schema.json" },
          { "$ref": "records/mcp_task.observation.schema.json" },
          { "$ref": "records/mcp_task.control_event.schema.json" },
          { "$ref": "records/mcp_task.poll_attempt.schema.json" },
          { "$ref": "records/mcp_task.input_link.schema.json" },
          { "$ref": "records/mcp_task.cancel.schema.json" },
          { "$ref": "records/mcp_task.reconciliation.schema.json" },
          { "$ref": "records/mcp_task.continuation_snapshot.schema.json" },
          { "$ref": "records/mcp_task.continuation_attempt.schema.json" },
          { "$ref": "records/capability.definition.schema.json" },
          { "$ref": "records/capability.implementation_binding.schema.json" },
          { "$ref": "records/capability.readiness.schema.json" },
          { "$ref": "records/capability.task_binding.schema.json" },
          { "$ref": "records/capability.execution_attempt.schema.json" },
          { "$ref": "records/capability.a2a_exposure.schema.json" },
          { "$ref": "records/capability.agent_card_revision.schema.json" },
          { "$ref": "records/experience.episode.schema.json" },
          { "$ref": "records/experience.trace.schema.json" },
          { "$ref": "records/experience.trace_event.schema.json" },
          { "$ref": "records/experience.activity.schema.json" },
          { "$ref": "records/experience.process_variant.schema.json" },
          { "$ref": "records/experience.workflow_pattern.schema.json" },
          { "$ref": "records/experience.workflow_pattern_dependency.schema.json" },
          { "$ref": "records/experience.recovery_pattern.schema.json" },
          { "$ref": "records/experience.planning_correction.schema.json" },
          { "$ref": "records/experience.interaction_episode.schema.json" },
          { "$ref": "records/replay.dataset.schema.json" },
          { "$ref": "records/replay.case.schema.json" },
          { "$ref": "records/replay.run.schema.json" },
          { "$ref": "records/replay.case_result.schema.json" },
          { "$ref": "records/replay.metric_result.schema.json" },
          { "$ref": "records/replay.counterexample.schema.json" },
          { "$ref": "records/artifact.lifecycle.schema.json" },
          { "$ref": "records/artifact.validation.schema.json" },
          { "$ref": "records/artifact.retrieval.schema.json" },
          { "$ref": "records/artifact.usage.schema.json" },
          { "$ref": "records/artifact.feedback.schema.json" },
          { "$ref": "records/artifact.promotion.schema.json" },
          { "$ref": "records/node_control.profile_revision.schema.json" },
          { "$ref": "records/node_control.health_observation.schema.json" },
          { "$ref": "records/node_control.configuration_revision.schema.json" },
          { "$ref": "records/node_control.configuration_apply_ack.schema.json" },
          { "$ref": "records/node_control.configuration_lkg_transition.schema.json" },
          { "$ref": "records/node_control.llm_provider_revision.schema.json" },
          { "$ref": "records/node_control.model_route_revision.schema.json" },
          { "$ref": "records/node_control.smpp_source_revision.schema.json" },
          { "$ref": "records/node_control.mcp_provider_binding_revision.schema.json" },
          { "$ref": "records/node_control.skill_governance.schema.json" },
          { "$ref": "records/node_control.plan_template_governance.schema.json" },
          { "$ref": "records/node_control.capability_revision.schema.json" },
          { "$ref": "records/node_control.capability_readiness.schema.json" },
          { "$ref": "records/node_control.a2a_exposure.schema.json" },
          { "$ref": "records/node_control.agent_card_revision.schema.json" },
          { "$ref": "records/node_control.management_operation.schema.json" },
          { "$ref": "records/node_control.audit_event.schema.json" },
          { "$ref": "records/node_control.node_event.schema.json" },
          { "$ref": "records/node_control.telemetry_configuration.schema.json" },
          { "$ref": "records/node_control.telemetry_delivery.schema.json" },
          { "$ref": "records/node_control.telemetry_ack.schema.json" },
          { "$ref": "records/evidence.episode_manifest.schema.json" },
          { "$ref": "records/evidence.quality_issue.schema.json" },
          { "$ref": "records/evidence.projection_issue.schema.json" },
          { "$ref": "records/evidence.source_checkpoint.schema.json" },
          { "$ref": "records/evidence.export_status.schema.json" }
        ]
      }
    }
  }
}
