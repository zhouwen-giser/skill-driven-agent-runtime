{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdar.local/evidence/v1/records/replay.case.schema.json",
  "title": "replay.case canonical evidence record",
  "description": "Canonical replay.case evidence projected from Runtime PostgreSQL artifact_replay_case.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "schemaName",
    "schemaVersion",
    "recordFamily",
    "recordType",
    "recordId",
    "sourceSystem",
    "sourceTable",
    "sourceRecordId",
    "sourceRevision",
    "environment",
    "correlationId",
    "occurredAt",
    "recordedAt",
    "deliveryGuarantee",
    "evaluationRole",
    "evidenceRefs",
    "artifactRefs",
    "payloadHash",
    "payload"
  ],
  "properties": {
    "contractVersion": { "const": "sdar.evidence/v1" },
    "schemaName": { "const": "sdar.evidence.replay.case" },
    "schemaVersion": { "const": 1 },
    "recordFamily": {
      "const": "replay",
      "enum": [
        "runtime",
        "skill",
        "mcp_task",
        "capability",
        "experience",
        "replay",
        "artifact",
        "node_control",
        "evidence"
      ]
    },
    "recordType": { "const": "replay.case" },
    "recordId": { "type": "string", "pattern": "^evidence_[0-9a-f]{64}$" },
    "sourceSystem": { "const": "runtime" },
    "sourceTable": { "const": "artifact_replay_case" },
    "sourceRecordId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "sourceRevision": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "environment": { "type": "string", "minLength": 1, "maxLength": 256 },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "deliveryGuarantee": { "const": "durable_projection" },
    "evaluationRole": { "const": "required" },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "artifactRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "payloadHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "payload": {
      "type": "object",
      "minProperties": 12,
      "maxProperties": 128,
      "required": [
        "replayCaseId",
        "taskTypeId",
        "tenantId",
        "primarySourceEpisodeId",
        "sourceEpisodeRefs",
        "goalLineageHash",
        "environmentClass",
        "deviceClass",
        "snapshotCompleteness",
        "contentHash",
        "sourceSnapshotHash",
        "artifactRef"
      ],
      "properties": {
        "replayCaseId": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "taskTypeId": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "tenantId": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "primarySourceEpisodeId": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "sourceEpisodeRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "goalLineageHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "environmentClass": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "deviceClass": {
          "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 4096 }, { "type": "null" }]
        },
        "snapshotCompleteness": { "type": "number", "minimum": 0, "maximum": 1 },
        "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "sourceSnapshotHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "artifactRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifactId", "version", "uri", "sha256", "mediaType", "byteSize"],
          "properties": {
            "artifactId": { "type": "string", "minLength": 1, "maxLength": 512 },
            "version": { "const": 1 },
            "uri": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^artifact://runtime/v1/artifact_replay_case/(?!\\.{1,2}/)(?:[A-Za-z0-9_.!~*'()-]|%(?:22|23|24|25|26|2B|2C|3A|3B|3C|3D|3E|3F|40|5B|5D|5E|60|7B|7C|7D)|(?:%(?:C[2-9A-F]|D[0-9A-F])%[89AB][0-9A-F]|%E0%[AB][0-9A-F]%[89AB][0-9A-F]|%E(?:[1-9A-C]|E|F)%[89AB][0-9A-F]%[89AB][0-9A-F]|%ED%[89][0-9A-F]%[89AB][0-9A-F]|%F0%[9AB][0-9A-F](?:%[89AB][0-9A-F]){2}|%F[1-3]%[89AB][0-9A-F](?:%[89AB][0-9A-F]){2}|%F4%8[0-9A-F](?:%[89AB][0-9A-F]){2}))(?:(?:(?:[A-Za-z0-9_.!~*'()-]|%(?:22|23|24|25|26|2B|2C|3A|3B|3C|3D|3E|3F|40|5B|5D|5E|60|7B|7C|7D)|(?:%(?:C[2-9A-F]|D[0-9A-F])%[89AB][0-9A-F]|%E0%[AB][0-9A-F]%[89AB][0-9A-F]|%E(?:[1-9A-C]|E|F)%[89AB][0-9A-F]%[89AB][0-9A-F]|%ED%[89][0-9A-F]%[89AB][0-9A-F]|%F0%[9AB][0-9A-F](?:%[89AB][0-9A-F]){2}|%F[1-3]%[89AB][0-9A-F](?:%[89AB][0-9A-F]){2}|%F4%8[0-9A-F](?:%[89AB][0-9A-F]){2}))|%20)*(?:[A-Za-z0-9_.!~*'()-]|%(?:22|23|24|25|26|2B|2C|3A|3B|3C|3D|3E|3F|40|5B|5D|5E|60|7B|7C|7D)|(?:%(?:C[2-9A-F]|D[0-9A-F])%[89AB][0-9A-F]|%E0%[AB][0-9A-F]%[89AB][0-9A-F]|%E(?:[1-9A-C]|E|F)%[89AB][0-9A-F]%[89AB][0-9A-F]|%ED%[89][0-9A-F]%[89AB][0-9A-F]|%F0%[9AB][0-9A-F](?:%[89AB][0-9A-F]){2}|%F[1-3]%[89AB][0-9A-F](?:%[89AB][0-9A-F]){2}|%F4%8[0-9A-F](?:%[89AB][0-9A-F]){2})))?/1/content$"
            },
            "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "mediaType": { "const": "application/json" },
            "byteSize": { "type": "integer", "minimum": 0, "maximum": 1048576 }
          }
        }
      },
      "additionalProperties": { "$ref": "#/$defs/evidenceValue" }
    },
    "goalVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "planVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "userScopeId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "projectId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "contextId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "episodeId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "goalId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "planId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "skillExecutionId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "capabilityBindingId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "remoteTaskBindingId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "nodeId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "causationId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "evidenceSequence": { "type": "string", "minLength": 1, "maxLength": 4096 }
  },
  "$defs": {
    "evidenceValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 65536 },
        { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/evidenceValue" } },
        {
          "type": "object",
          "maxProperties": 1024,
          "additionalProperties": { "$ref": "#/$defs/evidenceValue" }
        }
      ]
    },
    "artifactValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 65536 },
        { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/artifactValue" } },
        {
          "type": "object",
          "maxProperties": 128,
          "additionalProperties": { "$ref": "#/$defs/artifactValue" }
        }
      ]
    }
  },
  "x-sdar-compatibility": "backward_compatible_additive",
  "x-sdar-maximum-inline-bytes": 131072,
  "x-sdar-redaction-policy": "strict_internal_v1",
  "x-sdar-artifact-policy": "artifact_ref_required"
}
