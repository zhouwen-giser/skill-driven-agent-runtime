{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdar.local/evidence/v1/records/experience.interaction_episode.schema.json",
  "title": "experience.interaction_episode canonical evidence record",
  "description": "Canonical experience.interaction_episode evidence projected from Runtime PostgreSQL planning_interaction_episode.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "schemaName",
    "schemaVersion",
    "recordFamily",
    "recordType",
    "recordId",
    "sourceSystem",
    "sourceTable",
    "sourceRecordId",
    "sourceRevision",
    "environment",
    "correlationId",
    "occurredAt",
    "recordedAt",
    "deliveryGuarantee",
    "evaluationRole",
    "evidenceRefs",
    "artifactRefs",
    "payloadHash",
    "payload"
  ],
  "properties": {
    "contractVersion": { "const": "sdar.evidence/v1" },
    "schemaName": { "const": "sdar.evidence.experience.interaction_episode" },
    "schemaVersion": { "const": 1 },
    "recordFamily": {
      "const": "experience",
      "enum": [
        "runtime",
        "skill",
        "mcp_task",
        "capability",
        "experience",
        "replay",
        "artifact",
        "node_control",
        "evidence"
      ]
    },
    "recordType": { "const": "experience.interaction_episode" },
    "recordId": { "type": "string", "pattern": "^evidence_[0-9a-f]{64}$" },
    "sourceSystem": { "const": "runtime" },
    "sourceTable": { "const": "planning_interaction_episode" },
    "sourceRecordId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "sourceRevision": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "environment": { "type": "string", "minLength": 1, "maxLength": 256 },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "deliveryGuarantee": { "const": "durable_projection" },
    "evaluationRole": { "const": "required" },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "artifactRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "payloadHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "payload": {
      "type": "object",
      "minProperties": 12,
      "maxProperties": 128,
      "required": [
        "episodeId",
        "taskId",
        "revision",
        "goalId",
        "goalVersion",
        "completeness",
        "inductionFingerprint",
        "episodeHash",
        "outcomeRef",
        "correctionIds",
        "counterexampleRefs",
        "sourceRefs"
      ],
      "properties": {
        "episodeId": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "taskId": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "goalId": {
          "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 4096 }, { "type": "null" }]
        },
        "goalVersion": {
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 2147483647 }, { "type": "null" }]
        },
        "completeness": { "type": "number", "minimum": 0, "maximum": 1 },
        "inductionFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "episodeHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "outcomeRef": {
          "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 4096 }, { "type": "null" }]
        },
        "correctionIds": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "counterexampleRefs": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schemaVersion",
              "sourceRefId",
              "sourceKind",
              "sourceId",
              "sourceRevision",
              "authority",
              "dataClassification",
              "capturedAt"
            ],
            "properties": {
              "schemaVersion": { "const": "1.0" },
              "sourceRefId": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "sourceKind": {
                "type": "string",
                "enum": [
                  "task_request",
                  "task_understanding",
                  "capability_summary",
                  "task_type_definition",
                  "user_preference",
                  "goal_contract",
                  "plan_revision",
                  "skill_attempt",
                  "workflow_outcome",
                  "runtime_terminal_outcome",
                  "recovery_decision",
                  "business_event",
                  "planning_correction",
                  "model_invocation",
                  "goal_experience_episode",
                  "knowledge_revision",
                  "skill_version"
                ]
              },
              "sourceId": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "sourceRevision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
              "authority": {
                "type": "string",
                "enum": [
                  "runtime_fact",
                  "user_instruction",
                  "user_confirmation",
                  "domain_rule",
                  "model_candidate",
                  "promoted_knowledge",
                  "skill_declaration"
                ]
              },
              "dataClassification": {
                "type": "string",
                "enum": ["public", "internal", "user_scoped", "restricted"]
              },
              "capturedAt": { "type": "string", "format": "date-time" },
              "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          }
        }
      },
      "additionalProperties": { "$ref": "#/$defs/evidenceValue" },
      "oneOf": [
        {
          "type": "object",
          "required": ["goalId", "goalVersion"],
          "properties": { "goalId": { "const": null }, "goalVersion": { "const": null } }
        },
        {
          "type": "object",
          "required": ["goalId", "goalVersion"],
          "properties": {
            "goalId": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "goalVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
          }
        }
      ]
    },
    "goalVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "planVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "userScopeId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "projectId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "contextId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "episodeId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "goalId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "planId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "skillExecutionId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "capabilityBindingId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "remoteTaskBindingId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "nodeId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "causationId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "evidenceSequence": { "type": "string", "minLength": 1, "maxLength": 4096 }
  },
  "$defs": {
    "evidenceValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 65536 },
        { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/evidenceValue" } },
        {
          "type": "object",
          "maxProperties": 1024,
          "additionalProperties": { "$ref": "#/$defs/evidenceValue" }
        }
      ]
    },
    "artifactValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 65536 },
        { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/artifactValue" } },
        {
          "type": "object",
          "maxProperties": 128,
          "additionalProperties": { "$ref": "#/$defs/artifactValue" }
        }
      ]
    }
  },
  "x-sdar-compatibility": "backward_compatible_additive",
  "x-sdar-maximum-inline-bytes": 65536,
  "x-sdar-redaction-policy": "strict_internal_v1",
  "x-sdar-artifact-policy": "inline_bounded_or_artifact_ref"
}
