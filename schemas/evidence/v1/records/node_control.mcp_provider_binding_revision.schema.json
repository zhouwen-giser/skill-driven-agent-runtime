{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdar.local/evidence/v1/records/node_control.mcp_provider_binding_revision.schema.json",
  "title": "node_control.mcp_provider_binding_revision canonical evidence record",
  "description": "Canonical node_control.mcp_provider_binding_revision evidence projected from Control PostgreSQL sdar_control.mcp_provider_binding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "schemaName",
    "schemaVersion",
    "recordFamily",
    "recordType",
    "recordId",
    "sourceSystem",
    "sourceTable",
    "sourceRecordId",
    "sourceRevision",
    "environment",
    "correlationId",
    "occurredAt",
    "recordedAt",
    "deliveryGuarantee",
    "evaluationRole",
    "evidenceRefs",
    "artifactRefs",
    "payloadHash",
    "payload"
  ],
  "properties": {
    "contractVersion": { "const": "sdar.evidence/v1" },
    "schemaName": { "const": "sdar.evidence.node_control.mcp_provider_binding_revision" },
    "schemaVersion": { "const": 1 },
    "recordFamily": {
      "const": "node_control",
      "enum": [
        "runtime",
        "skill",
        "mcp_task",
        "capability",
        "experience",
        "replay",
        "artifact",
        "node_control",
        "evidence"
      ]
    },
    "recordType": { "const": "node_control.mcp_provider_binding_revision" },
    "recordId": { "type": "string", "pattern": "^evidence_[0-9a-f]{64}$" },
    "sourceSystem": { "const": "node_control" },
    "sourceTable": { "const": "sdar_control.mcp_provider_binding" },
    "sourceRecordId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "sourceRevision": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "environment": { "type": "string", "minLength": 1, "maxLength": 256 },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "deliveryGuarantee": { "const": "durable_projection" },
    "evaluationRole": { "const": "required" },
    "observationGeneration": { "type": "integer", "enum": [0, 1] },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "artifactRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "payloadHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "payload": {
      "type": "object",
      "minProperties": 18,
      "maxProperties": 128,
      "required": [
        "bindingId",
        "revision",
        "localServerId",
        "originType",
        "smppSourceId",
        "externalProviderId",
        "externalServerId",
        "registryRevision",
        "registryChecksum",
        "catalogRevision",
        "catalogChecksum",
        "endpointRef",
        "status",
        "availabilityStatus",
        "availabilityValidUntil",
        "catalogObservedAt",
        "operationCount",
        "createdAt"
      ],
      "properties": {
        "bindingId": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "localServerId": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "originType": { "type": "string", "enum": ["direct", "smpp_registry"] },
        "smppSourceId": {
          "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 4096 }, { "type": "null" }]
        },
        "externalProviderId": {
          "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 4096 }, { "type": "null" }]
        },
        "externalServerId": {
          "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 4096 }, { "type": "null" }]
        },
        "registryRevision": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        },
        "registryChecksum": {
          "oneOf": [{ "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, { "type": "null" }]
        },
        "catalogRevision": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "catalogChecksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "endpointRef": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "status": {
          "type": "string",
          "enum": ["candidate", "imported", "active", "degraded", "suspended", "removed"]
        },
        "availabilityStatus": {
          "type": "string",
          "enum": ["unknown", "available", "degraded", "unavailable"]
        },
        "availabilityValidUntil": { "type": "string", "format": "date-time" },
        "catalogObservedAt": { "type": "string", "format": "date-time" },
        "operationCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": { "$ref": "#/$defs/evidenceValue" },
      "oneOf": [
        {
          "type": "object",
          "required": [
            "originType",
            "smppSourceId",
            "externalProviderId",
            "externalServerId",
            "registryRevision",
            "registryChecksum"
          ],
          "properties": {
            "originType": { "const": "direct" },
            "smppSourceId": { "const": null },
            "externalProviderId": { "const": null },
            "externalServerId": { "const": null },
            "registryRevision": { "const": null },
            "registryChecksum": { "const": null }
          }
        },
        {
          "type": "object",
          "required": [
            "originType",
            "smppSourceId",
            "externalProviderId",
            "externalServerId",
            "registryRevision",
            "registryChecksum"
          ],
          "properties": {
            "originType": { "const": "smpp_registry" },
            "smppSourceId": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "externalProviderId": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "externalServerId": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "registryRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "registryChecksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        }
      ]
    },
    "goalVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "planVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "userScopeId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "projectId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "contextId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "episodeId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "goalId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "planId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "skillExecutionId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "capabilityBindingId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "remoteTaskBindingId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "nodeId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "causationId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "evidenceSequence": { "type": "string", "minLength": 1, "maxLength": 4096 }
  },
  "$defs": {
    "evidenceValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 65536 },
        { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/evidenceValue" } },
        {
          "type": "object",
          "maxProperties": 1024,
          "additionalProperties": { "$ref": "#/$defs/evidenceValue" }
        }
      ]
    },
    "artifactValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 65536 },
        { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/artifactValue" } },
        {
          "type": "object",
          "maxProperties": 128,
          "additionalProperties": { "$ref": "#/$defs/artifactValue" }
        }
      ]
    }
  },
  "x-sdar-compatibility": "backward_compatible_additive",
  "x-sdar-maximum-inline-bytes": 65536,
  "x-sdar-redaction-policy": "strict_internal_v1",
  "x-sdar-artifact-policy": "inline_bounded_or_artifact_ref"
}
