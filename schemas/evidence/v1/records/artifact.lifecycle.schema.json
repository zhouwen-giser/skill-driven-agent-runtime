{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdar.local/evidence/v1/records/artifact.lifecycle.schema.json",
  "title": "artifact.lifecycle canonical evidence record",
  "description": "Canonical artifact.lifecycle evidence projected from Runtime PostgreSQL compiled_artifact + artifact_lineage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "schemaName",
    "schemaVersion",
    "recordFamily",
    "recordType",
    "recordId",
    "sourceSystem",
    "sourceTable",
    "sourceRecordId",
    "sourceRevision",
    "environment",
    "correlationId",
    "occurredAt",
    "recordedAt",
    "deliveryGuarantee",
    "evaluationRole",
    "evidenceRefs",
    "artifactRefs",
    "payloadHash",
    "payload"
  ],
  "properties": {
    "contractVersion": { "const": "sdar.evidence/v1" },
    "schemaName": { "const": "sdar.evidence.artifact.lifecycle" },
    "schemaVersion": { "const": 1 },
    "recordFamily": {
      "const": "artifact",
      "enum": [
        "runtime",
        "skill",
        "mcp_task",
        "capability",
        "experience",
        "replay",
        "artifact",
        "node_control",
        "evidence"
      ]
    },
    "recordType": { "const": "artifact.lifecycle" },
    "recordId": { "type": "string", "pattern": "^evidence_[0-9a-f]{64}$" },
    "sourceSystem": { "const": "runtime" },
    "sourceTable": { "const": "compiled_artifact + artifact_lineage" },
    "sourceRecordId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "sourceRevision": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "environment": { "type": "string", "minLength": 1, "maxLength": 256 },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "deliveryGuarantee": { "const": "durable_projection" },
    "evaluationRole": { "const": "required" },
    "observationGeneration": { "type": "integer", "enum": [0, 1] },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "artifactRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "payloadHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "payload": {
      "type": "object",
      "minProperties": 12,
      "maxProperties": 128,
      "required": [
        "artifactId",
        "version",
        "contentHash",
        "artifactType",
        "status",
        "tenantId",
        "domain",
        "riskLevel",
        "policyRefs",
        "authorityRef",
        "artifactRef",
        "lineage"
      ],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "artifactType": {
          "type": "string",
          "enum": ["intent_route", "plan_template", "decision_rule", "case_template", "model_route"]
        },
        "status": {
          "type": "string",
          "enum": [
            "discovered",
            "candidate",
            "validating",
            "awaiting_approval",
            "active",
            "revalidating",
            "deprecated",
            "archived",
            "rejected"
          ]
        },
        "tenantId": {
          "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 4096 }, { "type": "null" }]
        },
        "domain": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "riskLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "policyRefs": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "authorityRef": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "artifactRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifactId", "version", "uri", "sha256", "mediaType", "byteSize"],
          "properties": {
            "artifactId": { "type": "string", "minLength": 1, "maxLength": 512 },
            "version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
            "uri": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^artifact://runtime/v1/compiled_artifact/(?!\\.{1,2}/)(?:[A-Za-z0-9_.!~*'()-]|%(?:22|23|24|25|26|2B|2C|3A|3B|3C|3D|3E|3F|40|5B|5D|5E|60|7B|7C|7D)|(?:%(?:C[2-9A-F]|D[0-9A-F])%[89AB][0-9A-F]|%E0%[AB][0-9A-F]%[89AB][0-9A-F]|%E(?:[1-9A-C]|E|F)%[89AB][0-9A-F]%[89AB][0-9A-F]|%ED%[89][0-9A-F]%[89AB][0-9A-F]|%F0%[9AB][0-9A-F](?:%[89AB][0-9A-F]){2}|%F[1-3]%[89AB][0-9A-F](?:%[89AB][0-9A-F]){2}|%F4%8[0-9A-F](?:%[89AB][0-9A-F]){2}))(?:(?:(?:[A-Za-z0-9_.!~*'()-]|%(?:22|23|24|25|26|2B|2C|3A|3B|3C|3D|3E|3F|40|5B|5D|5E|60|7B|7C|7D)|(?:%(?:C[2-9A-F]|D[0-9A-F])%[89AB][0-9A-F]|%E0%[AB][0-9A-F]%[89AB][0-9A-F]|%E(?:[1-9A-C]|E|F)%[89AB][0-9A-F]%[89AB][0-9A-F]|%ED%[89][0-9A-F]%[89AB][0-9A-F]|%F0%[9AB][0-9A-F](?:%[89AB][0-9A-F]){2}|%F[1-3]%[89AB][0-9A-F](?:%[89AB][0-9A-F]){2}|%F4%8[0-9A-F](?:%[89AB][0-9A-F]){2}))|%20)*(?:[A-Za-z0-9_.!~*'()-]|%(?:22|23|24|25|26|2B|2C|3A|3B|3C|3D|3E|3F|40|5B|5D|5E|60|7B|7C|7D)|(?:%(?:C[2-9A-F]|D[0-9A-F])%[89AB][0-9A-F]|%E0%[AB][0-9A-F]%[89AB][0-9A-F]|%E(?:[1-9A-C]|E|F)%[89AB][0-9A-F]%[89AB][0-9A-F]|%ED%[89][0-9A-F]%[89AB][0-9A-F]|%F0%[9AB][0-9A-F](?:%[89AB][0-9A-F]){2}|%F[1-3]%[89AB][0-9A-F](?:%[89AB][0-9A-F]){2}|%F4%8[0-9A-F](?:%[89AB][0-9A-F]){2})))?/(?:[1-9][0-9]{0,8}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])/definition/artifact/definition$"
            },
            "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "mediaType": { "const": "application/json" },
            "byteSize": { "type": "integer", "minimum": 0, "maximum": 1048576 }
          }
        },
        "lineage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lineage_id",
            "artifact_id",
            "artifact_version",
            "source_episode_refs",
            "source_knowledge_refs",
            "source_correction_refs",
            "source_pattern_refs",
            "generation_methods",
            "compiler_version",
            "created_at"
          ],
          "properties": {
            "lineage_id": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "artifact_id": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "artifact_version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
            "source_episode_refs": {
              "type": "array",
              "maxItems": 4096,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
            },
            "source_knowledge_refs": {
              "type": "array",
              "maxItems": 4096,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
            },
            "source_correction_refs": {
              "type": "array",
              "maxItems": 4096,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
            },
            "source_pattern_refs": {
              "type": "array",
              "maxItems": 4096,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
            },
            "generation_methods": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "process_mining",
                  "workflow_induction",
                  "rule_mining",
                  "case_mining",
                  "model_assisted_generalization",
                  "human_authored"
                ]
              }
            },
            "compiler_version": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "created_at": { "type": "string", "format": "date-time" }
          }
        }
      },
      "additionalProperties": { "$ref": "#/$defs/evidenceValue" }
    },
    "goalVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "planVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "userScopeId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "projectId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "contextId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "episodeId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "goalId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "planId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "skillExecutionId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "capabilityBindingId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "remoteTaskBindingId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "nodeId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "causationId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "evidenceSequence": { "type": "string", "minLength": 1, "maxLength": 4096 }
  },
  "$defs": {
    "evidenceValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 65536 },
        { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/evidenceValue" } },
        {
          "type": "object",
          "maxProperties": 1024,
          "additionalProperties": { "$ref": "#/$defs/evidenceValue" }
        }
      ]
    },
    "artifactValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 65536 },
        { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/artifactValue" } },
        {
          "type": "object",
          "maxProperties": 128,
          "additionalProperties": { "$ref": "#/$defs/artifactValue" }
        }
      ]
    }
  },
  "x-sdar-compatibility": "backward_compatible_additive",
  "x-sdar-maximum-inline-bytes": 131072,
  "x-sdar-redaction-policy": "strict_internal_v1",
  "x-sdar-artifact-policy": "artifact_ref_required"
}
