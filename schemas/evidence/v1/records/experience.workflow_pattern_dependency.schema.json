          "type": "object",
          "additionalProperties": false,
          "required": ["type", "field", "operator", "value"],
          "properties": {
            "type": { "const": "atomic" },
            "field": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "operator": {
              "type": "string",
              "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "in", "contains"]
