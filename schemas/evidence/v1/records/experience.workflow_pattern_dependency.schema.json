          "required": ["type", "child"],
          "properties": {
            "type": { "const": "not" },
            "child": { "$ref": "#/$defs/conditionExpression" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "field", "operator"],
          "properties": {
            "type": { "const": "atomic" },
            "field": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "operator": { "const": "exists" }
          }
        },
