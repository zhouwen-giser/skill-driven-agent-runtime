{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdar.local/evidence/v1/records/evidence.export_status.schema.json",
  "title": "evidence.export_status canonical evidence record",
  "description": "Canonical evidence.export_status evidence projected from Runtime PostgreSQL evidence_export_batch + evidence_export_ack[generation0-derived].",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "schemaName",
    "schemaVersion",
    "recordFamily",
    "recordType",
    "recordId",
    "sourceSystem",
    "sourceTable",
    "sourceRecordId",
    "sourceRevision",
    "environment",
    "correlationId",
    "occurredAt",
    "recordedAt",
    "deliveryGuarantee",
    "evaluationRole",
    "evidenceRefs",
    "artifactRefs",
    "payloadHash",
    "payload"
  ],
  "properties": {
    "contractVersion": { "const": "sdar.evidence/v1" },
    "schemaName": { "const": "sdar.evidence.evidence.export_status" },
    "schemaVersion": { "const": 1 },
    "recordFamily": {
      "const": "evidence",
      "enum": [
        "runtime",
        "skill",
        "mcp_task",
        "capability",
        "experience",
        "replay",
        "artifact",
        "node_control",
        "evidence"
      ]
    },
    "recordType": { "const": "evidence.export_status" },
    "recordId": { "type": "string", "pattern": "^evidence_[0-9a-f]{64}$" },
    "sourceSystem": { "const": "runtime" },
    "sourceTable": { "const": "evidence_export_batch + evidence_export_ack[generation0-derived]" },
    "sourceRecordId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "sourceRevision": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "environment": { "type": "string", "minLength": 1, "maxLength": 256 },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "deliveryGuarantee": { "const": "durable_projection" },
    "evaluationRole": { "const": "diagnostic" },
    "observationGeneration": { "type": "integer", "enum": [0, 1] },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "artifactRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "payloadHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "payload": {
      "type": "object",
      "minProperties": 17,
      "maxProperties": 128,
      "required": [
        "exportId",
        "sourcePartition",
        "batchId",
        "configurationRevision",
        "firstSequence",
        "lastSequence",
        "batchHash",
        "recordCount",
        "attemptNo",
        "status",
        "recordedAt",
        "ackId",
        "acknowledgedSequence",
        "ackDisposition",
        "errorCode",
        "acknowledgedAt",
        "observedAt"
      ],
      "properties": {
        "exportId": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "sourcePartition": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "batchId": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "configurationRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "firstSequence": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,18})$" },
        "lastSequence": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,18})$" },
        "batchHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "recordCount": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "attemptNo": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "status": { "type": "string", "enum": ["attempted", "acknowledged", "rejected"] },
        "recordedAt": { "type": "string", "format": "date-time" },
        "ackId": {
          "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 4096 }, { "type": "null" }]
        },
        "acknowledgedSequence": {
          "oneOf": [{ "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,18})$" }, { "type": "null" }]
        },
        "ackDisposition": {
          "oneOf": [
            { "type": "string", "enum": ["accepted", "partial", "rejected"] },
            { "type": "null" }
          ]
        },
        "errorCode": {
          "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 4096 }, { "type": "null" }]
        },
        "acknowledgedAt": {
          "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
        },
        "observedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": { "$ref": "#/$defs/evidenceValue" },
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "ackId",
            "acknowledgedSequence",
            "ackDisposition",
            "errorCode",
            "acknowledgedAt"
          ],
          "properties": {
            "status": { "const": "attempted" },
            "ackId": { "const": null },
            "acknowledgedSequence": { "const": null },
            "ackDisposition": { "const": null },
            "errorCode": { "const": null },
            "acknowledgedAt": { "const": null }
          }
        },
        {
          "type": "object",
          "required": [
            "status",
            "ackId",
            "acknowledgedSequence",
            "ackDisposition",
            "errorCode",
            "acknowledgedAt"
          ],
          "properties": {
            "status": { "const": "acknowledged" },
            "ackId": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "acknowledgedSequence": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,18})$" },
            "ackDisposition": { "type": "string", "enum": ["accepted", "partial"] },
            "errorCode": { "const": null },
            "acknowledgedAt": { "type": "string", "format": "date-time" }
          }
        },
        {
          "type": "object",
          "required": [
            "status",
            "ackId",
            "acknowledgedSequence",
            "ackDisposition",
            "errorCode",
            "acknowledgedAt"
          ],
          "properties": {
            "status": { "const": "rejected" },
            "ackId": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "acknowledgedSequence": { "const": null },
            "ackDisposition": { "const": "rejected" },
            "errorCode": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "acknowledgedAt": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "goalVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "planVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "userScopeId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "projectId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "contextId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "episodeId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "goalId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "planId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "skillExecutionId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "capabilityBindingId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "remoteTaskBindingId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "nodeId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "causationId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "evidenceSequence": { "type": "string", "minLength": 1, "maxLength": 4096 }
  },
  "$defs": {
    "evidenceValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 65536 },
        { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/evidenceValue" } },
        {
          "type": "object",
          "maxProperties": 1024,
          "additionalProperties": { "$ref": "#/$defs/evidenceValue" }
        }
      ]
    },
    "artifactValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 65536 },
        { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/artifactValue" } },
        {
          "type": "object",
          "maxProperties": 128,
          "additionalProperties": { "$ref": "#/$defs/artifactValue" }
        }
      ]
    }
  },
  "x-sdar-compatibility": "backward_compatible_additive",
  "x-sdar-maximum-inline-bytes": 65536,
  "x-sdar-redaction-policy": "strict_internal_v1",
  "x-sdar-artifact-policy": "inline_bounded_or_artifact_ref"
}
