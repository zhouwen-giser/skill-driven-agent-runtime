{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdar.local/evidence/v1/records/evidence.episode_manifest.schema.json",
  "title": "evidence.episode_manifest canonical evidence record",
  "description": "Canonical evidence.episode_manifest evidence projected from Runtime PostgreSQL episode_evidence_manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "schemaName",
    "schemaVersion",
    "recordFamily",
    "recordType",
    "recordId",
    "sourceSystem",
    "sourceTable",
    "sourceRecordId",
    "sourceRevision",
    "environment",
    "correlationId",
    "occurredAt",
    "recordedAt",
    "deliveryGuarantee",
    "evaluationRole",
    "evidenceRefs",
    "artifactRefs",
    "payloadHash",
    "payload"
  ],
  "properties": {
    "contractVersion": { "const": "sdar.evidence/v1" },
    "schemaName": { "const": "sdar.evidence.evidence.episode_manifest" },
    "schemaVersion": { "const": 1 },
    "recordFamily": {
      "const": "evidence",
      "enum": [
        "runtime",
        "skill",
        "mcp_task",
        "capability",
        "experience",
        "replay",
        "artifact",
        "node_control",
        "evidence"
      ]
    },
    "recordType": { "const": "evidence.episode_manifest" },
    "recordId": { "type": "string", "pattern": "^evidence_[0-9a-f]{64}$" },
    "sourceSystem": { "const": "runtime" },
    "sourceTable": { "const": "episode_evidence_manifest" },
    "sourceRecordId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "sourceRevision": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "environment": { "type": "string", "minLength": 1, "maxLength": 256 },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "deliveryGuarantee": { "const": "durable_projection" },
    "evaluationRole": { "const": "required" },
    "observationGeneration": { "type": "integer", "enum": [0, 1] },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "artifactRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "payloadHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "payload": {
      "type": "object",
      "minProperties": 21,
      "maxProperties": 128,
      "required": [
        "manifestId",
        "revision",
        "policyVersion",
        "episodeId",
        "taskId",
        "terminalOutcomeId",
        "expectedRequiredRecords",
        "projectedRequiredRecords",
        "pendingRequiredRecords",
        "failedRequiredRecords",
        "expectedFamilies",
        "completedFamilies",
        "missingFamilies",
        "sourceCoverage",
        "lastEvidenceSequence",
        "status",
        "qualityIssueIds",
        "sourceSnapshotHash",
        "createdAt",
        "recomputedAt",
        "sealedAt"
      ],
      "properties": {
        "manifestId": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "policyVersion": { "const": "episode-evidence-policy/v1" },
        "episodeId": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "taskId": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "terminalOutcomeId": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "expectedRequiredRecords": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "projectedRequiredRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pendingRequiredRecords": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "failedRequiredRecords": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "expectedFamilies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "runtime",
              "skill",
              "mcp_task",
              "capability",
              "experience",
              "replay",
              "artifact",
              "node_control",
              "evidence"
            ]
          }
        },
        "completedFamilies": {
          "type": "array",
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "runtime",
              "skill",
              "mcp_task",
              "capability",
              "experience",
              "replay",
              "artifact",
              "node_control",
              "evidence"
            ]
          }
        },
        "missingFamilies": {
          "type": "array",
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "runtime",
              "skill",
              "mcp_task",
              "capability",
              "experience",
              "replay",
              "artifact",
              "node_control",
              "evidence"
            ]
          }
        },
        "sourceCoverage": {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expected", "projected", "pending", "failed"],
            "properties": {
              "expected": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "projected": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "pending": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "failed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "lastSourceRevision": { "type": "string", "minLength": 1, "maxLength": 4096 }
            }
          }
        },
        "lastEvidenceSequence": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,18})$" },
        "status": {
          "type": "string",
          "enum": ["projecting", "complete", "degraded", "incomplete"]
        },
        "qualityIssueIds": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "sourceSnapshotHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "recomputedAt": { "type": "string", "format": "date-time" },
        "sealedAt": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] }
      },
      "additionalProperties": { "$ref": "#/$defs/evidenceValue" },
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "sealedAt"],
          "properties": { "status": { "const": "projecting" }, "sealedAt": { "const": null } }
        },
        {
          "type": "object",
          "required": ["status", "sealedAt"],
          "properties": {
            "status": { "type": "string", "enum": ["complete", "degraded", "incomplete"] },
            "sealedAt": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "goalVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "planVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "userScopeId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "projectId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "contextId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "episodeId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "goalId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "planId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "skillExecutionId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "capabilityBindingId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "remoteTaskBindingId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "nodeId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "causationId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "evidenceSequence": { "type": "string", "minLength": 1, "maxLength": 4096 }
  },
  "$defs": {
    "evidenceValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 65536 },
        { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/evidenceValue" } },
        {
          "type": "object",
          "maxProperties": 1024,
          "additionalProperties": { "$ref": "#/$defs/evidenceValue" }
        }
      ]
    },
    "artifactValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 65536 },
        { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/artifactValue" } },
        {
          "type": "object",
          "maxProperties": 128,
          "additionalProperties": { "$ref": "#/$defs/artifactValue" }
        }
      ]
    }
  },
  "x-sdar-compatibility": "backward_compatible_additive",
  "x-sdar-maximum-inline-bytes": 65536,
  "x-sdar-redaction-policy": "strict_internal_v1",
  "x-sdar-artifact-policy": "inline_bounded_or_artifact_ref"
}
