{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdar.local/evidence/v1/records/evidence.projection_issue.schema.json",
  "title": "evidence.projection_issue canonical evidence record",
  "description": "Canonical evidence.projection_issue evidence projected from Runtime PostgreSQL evidence_projection_issue.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "schemaName",
    "schemaVersion",
    "recordFamily",
    "recordType",
    "recordId",
    "sourceSystem",
    "sourceTable",
    "sourceRecordId",
    "sourceRevision",
    "environment",
    "correlationId",
    "occurredAt",
    "recordedAt",
    "deliveryGuarantee",
    "evaluationRole",
    "evidenceRefs",
    "artifactRefs",
    "payloadHash",
    "payload"
  ],
  "properties": {
    "contractVersion": { "const": "sdar.evidence/v1" },
    "schemaName": { "const": "sdar.evidence.evidence.projection_issue" },
    "schemaVersion": { "const": 1 },
    "recordFamily": {
      "const": "evidence",
      "enum": [
        "runtime",
        "skill",
        "mcp_task",
        "capability",
        "experience",
        "replay",
        "artifact",
        "node_control",
        "evidence"
      ]
    },
    "recordType": { "const": "evidence.projection_issue" },
    "recordId": { "type": "string", "pattern": "^evidence_[0-9a-f]{64}$" },
    "sourceSystem": { "const": "runtime" },
    "sourceTable": { "const": "evidence_projection_issue" },
    "sourceRecordId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "sourceRevision": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "environment": { "type": "string", "minLength": 1, "maxLength": 256 },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "deliveryGuarantee": { "const": "durable_projection" },
    "evaluationRole": { "const": "diagnostic" },
    "observationGeneration": { "type": "integer", "enum": [0, 1] },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "artifactRefs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "payloadHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "payload": {
      "type": "object",
      "minProperties": 17,
      "maxProperties": 128,
      "required": [
        "issueId",
        "revision",
        "issueCode",
        "severity",
        "evaluationRole",
        "recordType",
        "recordId",
        "episodeId",
        "sourceSystem",
        "sourceTable",
        "sourceRecordId",
        "sourcePartition",
        "projectorVersion",
        "retryable",
        "detail",
        "createdAt",
        "resolvedAt"
      ],
      "properties": {
        "issueId": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "issueCode": {
          "type": "string",
          "enum": [
            "schema_invalid",
            "source_identity_missing",
            "source_revision_missing",
            "payload_hash_conflict",
            "reference_unresolved",
            "redaction_rejected",
            "artifact_write_failed",
            "export_rejected",
            "ack_invalid",
            "source_unavailable",
            "projection_bug"
          ]
        },
        "severity": { "type": "string", "enum": ["diagnostic", "degraded", "blocking"] },
        "evaluationRole": { "type": "string", "enum": ["required", "supporting", "diagnostic"] },
        "recordType": {
          "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 4096 }, { "type": "null" }]
        },
        "recordId": {
          "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 4096 }, { "type": "null" }]
        },
        "episodeId": {
          "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 4096 }, { "type": "null" }]
        },
        "sourceSystem": { "type": "string", "enum": ["runtime", "node_control"] },
        "sourceTable": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "sourceRecordId": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "sourcePartition": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "projectorVersion": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "retryable": { "type": "boolean" },
        "detail": {
          "type": "object",
          "maxProperties": 1024,
          "additionalProperties": { "$ref": "#/$defs/evidenceValue" }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "resolvedAt": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] }
      },
      "additionalProperties": { "$ref": "#/$defs/evidenceValue" }
    },
    "goalVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "planVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "userScopeId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "projectId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "contextId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "episodeId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "goalId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "planId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "skillExecutionId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "capabilityBindingId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "remoteTaskBindingId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "nodeId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "causationId": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "evidenceSequence": { "type": "string", "minLength": 1, "maxLength": 4096 }
  },
  "$defs": {
    "evidenceValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 65536 },
        { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/evidenceValue" } },
        {
          "type": "object",
          "maxProperties": 1024,
          "additionalProperties": { "$ref": "#/$defs/evidenceValue" }
        }
      ]
    },
    "artifactValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 65536 },
        { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/artifactValue" } },
        {
          "type": "object",
          "maxProperties": 128,
          "additionalProperties": { "$ref": "#/$defs/artifactValue" }
        }
      ]
    }
  },
  "x-sdar-compatibility": "backward_compatible_additive",
  "x-sdar-maximum-inline-bytes": 65536,
  "x-sdar-redaction-policy": "strict_internal_v1",
  "x-sdar-artifact-policy": "inline_bounded_or_artifact_ref"
}
