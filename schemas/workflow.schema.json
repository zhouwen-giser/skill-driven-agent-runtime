{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdar.local/schemas/workflow.schema.json",
  "title": "WorkflowDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "version",
    "goal_ref",
    "skill_refs",
    "entry_node",
    "nodes",
    "edges",
    "state_schema",
    "budgets"
  ],
  "properties": {
    "workflow_id": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "goal_ref": {
      "type": "object",
      "required": ["goal_id", "goal_version"],
      "properties": {
        "goal_id": {
          "type": "string"
        },
        "goal_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "skill_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill_id"],
        "properties": {
          "skill_id": {
            "type": "string"
          },
          "planned_version": {
            "type": ["integer", "null"],
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "state_schema": {
      "type": "object"
    },
    "entry_node": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "output_mapping": {
      "type": "object"
    },
    "budgets": {
      "type": "object",
      "required": ["max_duration_seconds", "max_llm_calls", "max_mcp_calls"],
      "properties": {
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_llm_calls": {
          "type": "integer",
          "minimum": 1
        },
        "max_mcp_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_loop_iterations": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "mapping": {
      "type": "object",
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "name", "config"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "type": {
          "enum": [
            "llm",
            "mcp_tool",
            "result",
            "condition",
            "parallel",
            "loop",
            "subworkflow",
            "human_confirmation",
            "error_handler",
            "skill_call"
          ]
        },
        "name": {
          "type": "string"
        },
        "input_mapping": {
          "$ref": "#/$defs/mapping"
        },
        "output_mapping": {
          "$ref": "#/$defs/mapping"
        },
        "config": {
          "type": "object"
        },
        "on_error": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "condition": {
          "oneOf": [
            {
              "type": "object",
              "required": ["var"],
              "properties": {
                "var": {
                  "type": "string",
                  "pattern": "^state(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["const"],
              "properties": {
                "const": {}
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["op"],
              "properties": {
                "op": {
                  "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "and", "or", "not", "exists", "in"]
                },
                "left": {},
                "right": {},
                "value": {},
                "args": {
                  "type": "array"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
