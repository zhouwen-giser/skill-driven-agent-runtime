{
  "apiVersion": "sdar.io/v1alpha1",
  "kind": "SkillPackage",
  "skill": {
    "skillId": "embodied.area_patrol",
    "version": 1,
    "name": "Area Patrol",
    "summary": "Patrol an authorized area with bounded composition and explicit degraded evidence.",
    "description": "Partitions an area, composes exact movement and dynamic inspection capabilities, and aggregates coverage, trajectory, and anomaly evidence.",
    "capabilities": ["embodied.area_patrol", "embodied.coverage", "embodied.anomaly_reporting"],
    "workflowGuidance": "Resolve authoritative boundary, resource, and time-window context before bounded subregion composition and evidence aggregation.",
    "outputInstruction": "Return full or degraded status, covered and missing subregions, trajectory, anomalies, Provider outcomes, and missing effects or evidence.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceId", "area", "timeWindow"],
      "properties": {
        "resourceId": { "type": "string", "minLength": 1 },
        "area": {
          "type": "object",
          "additionalProperties": false,
          "required": ["boundary"],
          "properties": {
            "boundary": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["x", "y"],
                "properties": {
                  "x": { "type": "number" },
                  "y": { "type": "number" }
                }
              }
            },
            "excludedZones": { "type": "array", "items": { "type": "string" } }
          }
        },
        "timeWindow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["earliestStart", "deadline"],
          "properties": {
            "earliestStart": { "type": "string" },
            "deadline": { "type": "string" }
          }
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "coveredSubregions", "missingSubregions", "trajectory", "anomalies"],
      "properties": {
        "status": { "enum": ["completed", "degraded", "failed", "cancelled"] },
        "coveredSubregions": { "type": "array", "items": { "type": "string" } },
        "missingSubregions": { "type": "array", "items": { "type": "string" } },
        "trajectory": { "type": "array", "items": { "type": "object" } },
        "anomalies": { "type": "array", "items": { "type": "object" } },
        "missingEffects": { "type": "array", "items": { "type": "string" } },
        "missingEvidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "toolPolicy": { "required": [], "optional": [], "forbidden": [] },
    "runtimePolicy": {
      "autoConfirmPlan": false,
      "maxReplans": 2,
      "maxDurationSeconds": 3600,
      "maxMcpCalls": 64,
      "cancelStrategy": "try_interrupt",
      "compensationGuidance": "Stop new subregions, preserve partial evidence, and report Provider uncertainty."
    },
    "status": "enabled",
    "sourceKind": "admin",
    "validationPassed": true,
    "createdAt": "2026-07-17T00:00:00.000Z"
  },
  "skillMarkdownSha256": "359c91c59763adf5524715e9e431ce986747aed2cc83096cb6232cf3e903d1eb",
