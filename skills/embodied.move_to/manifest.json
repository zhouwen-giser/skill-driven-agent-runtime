{
  "apiVersion": "sdar.io/v1alpha1",
  "kind": "SkillPackage",
  "skill": {
    "skillId": "embodied.move_to",
    "version": 1,
    "name": "Move To",
    "summary": "Move an identified resource to a permitted target with final-position evidence.",
    "description": "Uses an authoritative movement Provider while preserving permission, forbidden-area, cancellation, failure, and evidence policy.",
    "capabilities": ["embodied.move", "embodied.navigation"],
    "workflowGuidance": "Resolve authoritative context, bind the declared movement Task, and hard-gate completion on final-position evidence.",
    "outputInstruction": "Return the Provider outcome, final authoritative position, achieved target, and any cancellation or failure uncertainty.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceId", "target"],
      "properties": {
        "resourceId": { "type": "string", "minLength": 1 },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "frame": { "type": "string" }
          }
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceId", "status", "finalPosition"],
      "properties": {
        "resourceId": { "type": "string" },
        "status": { "enum": ["completed", "failed", "cancelled", "uncertain"] },
        "finalPosition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "frame": { "type": "string" }
          }
        }
      }
    },
    "toolPolicy": { "required": [], "optional": [], "forbidden": [] },
    "runtimePolicy": {
      "autoConfirmPlan": false,
      "maxReplans": 1,
      "maxDurationSeconds": 600,
      "maxMcpCalls": 8,
      "cancelStrategy": "try_interrupt"
    },
    "status": "enabled",
    "sourceKind": "admin",
    "validationPassed": true,
    "createdAt": "2026-07-17T00:00:00.000Z"
  },
