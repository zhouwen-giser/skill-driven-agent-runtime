# Copy values into a deployment secret manager or export them into the process environment.
# This file is a non-production template. Never commit the populated deployment environment.

# The current project phase starts as development. Qualification/production require an explicit
# environment change and are not inferred from this profile.
NODE_ENV=development

# SDAR Runtime infrastructure
SDAR_POSTGRES_URL=postgresql://sdar:<runtime-db-password>@127.0.0.1:55432/sdar
SDAR_REDIS_HOST=127.0.0.1
SDAR_REDIS_PORT=56379
SDAR_MASTER_KEY_BASE64=
SDAR_A2A_HOST=127.0.0.1
SDAR_A2A_PORT=9999
SDAR_A2A_WAIT_TIMEOUT_MS=300000
SDAR_MANAGEMENT_HOST=127.0.0.1
SDAR_MANAGEMENT_PORT=9998
SDAR_ACKNOWLEDGE_NO_AUTH_NETWORK_EXPOSURE=false
SDAR_TASK_UNDERSTANDING_PROFILE=ugv-agent-profile
ALLOW_UGV_LIVE_SIDE_EFFECTS=YES
ALLOW_UGV_SIMULATION_SIDE_EFFECTS=YES

# Runtime-to-Node-Control connectivity. Role credentials must be at least 32 characters and
# distinct unless two variables are the documented client/server ends of the same service channel.
# SDAR_NODE_CONTROL_EVIDENCE_SERVICE_TOKEN, SDAR_CONTROL_VIEWER_API_TOKEN and
# SDAR_CONTROL_RUNTIME_SERVICE_TOKEN are the client/viewer/internal ends of that one read channel.
SDAR_NODE_CONTROL_BASE_URL=http://127.0.0.1:10081
SDAR_NODE_CONTROL_EVIDENCE_SERVICE_TOKEN=
SDAR_COGNITIVE_MANAGEMENT_BEARER_TOKEN=
SDAR_RUNTIME_CONTROL_SERVICE_TOKEN=
# Dedicated trusted-human Runtime management identity. Do not reuse a service credential.
# SDAR_GOVERNED_CONTROL_BEARER_TOKEN=replace_with_at_least_32_non_whitespace_characters
# SDAR_GOVERNED_CONTROL_ACTOR_ID=human:physical-control-operator
# SDAR_GOVERNED_CONTROL_PERMISSIONS=physical_control.confirm,physical_control.revoke

# Node Control infrastructure and service identity
SDAR_CONTROL_DATABASE_URL=postgresql://sdar_control:<control-db-password>@127.0.0.1:55433/sdar_control
SDAR_CONTROL_RUNTIME_DATABASE_URL=postgresql://sdar:<runtime-db-password>@127.0.0.1:55432/sdar
SDAR_CONTROL_API_HOST=127.0.0.1
SDAR_CONTROL_API_PORT=10081
SDAR_CONTROL_API_TOKEN=
SDAR_CONTROL_OPERATOR_API_TOKEN=
SDAR_CONTROL_VIEWER_API_TOKEN=
SDAR_CONTROL_RUNTIME_SERVICE_TOKEN=
SDAR_CONTROL_NODE_ID=ugv-smpp-sdar-node
SDAR_CONTROL_NODE_TYPE=sdar-runtime
SDAR_CONTROL_NODE_DISPLAY_NAME=UGV SMPP SDAR Node
SDAR_CONTROL_ENVIRONMENT=development
SDAR_CONTROL_RUNTIME_ENDPOINT_REF=http://127.0.0.1:9998
SDAR_CONTROL_PUBLIC_URL=http://127.0.0.1:10081
SDAR_CONTROL_NODE_EVENTS_URL=http://127.0.0.1:10081/api/v1/events
SDAR_CONTROL_A2A_AGENT_CARD_URL=http://127.0.0.1:9999/.well-known/agent-card.json

# Current integration-only global relaxation: bypass HTTPS-required and SSRF authority checks for
# credential-free HTTP(S) URLs. This is rejected in production. HTTPS certificate validation stays on.
SDAR_CONTROL_OUTBOUND_ENDPOINT_POLICY=unsafe_test_open
SDAR_MCP_LIVE_EXECUTION_MODE_HEADER=omit

# Retain the discovered authorities as inventory even though unsafe_test_open bypasses membership.
SDAR_CONTROL_PROVIDER_ENDPOINT_ALLOWLIST=192.168.1.7:18088
SDAR_CONTROL_MCP_ENDPOINT_ALLOWLIST=192.168.1.7:19100

# External, already-deployed SMPP Registry projection. SDAR never starts or packages SMPP.
SMPP_SDAR_SOURCE_ID=ugv-smpp
SMPP_SDAR_SOURCE_NAME=UGV SMPP production projection
SMPP_ENVIRONMENT=production
# Must be the protected sdar-registry-v1 projection, not the Console-native snapshot. The currently
# deployed PMS Web API exposes this public projection without authentication.
SMPP_SDAR_REGISTRY_ENDPOINT=http://192.168.1.7:18088/api/v1/registry/production/consumers/sdar/v1/sources/ugv-smpp/latest
SMPP_REGISTRY_CREDENTIAL_REF=unauthenticated://none
SMPP_REGISTRY_TOKEN=
SMPP_REGISTRY_TOKEN_FILE=
SMPP_SDAR_SYNC_MODE=poll
SMPP_SDAR_SNAPSHOT_TTL_SECONDS=300
SMPP_SDAR_LKG_POLICY=allow_unexpired

# Every bootstrap attempt requires a new bounded run ID. Leaving this empty fails closed.
SDAR_UGV_BOOTSTRAP_RUN_ID=

# The currently supplied UGV Runtime deployment is port 19100. This is not the Registry URL.
# The Registry candidate remains authority and must resolve to exactly <base><mcp-path>.
SMPP_UGV_RUNTIME_BASE_URL=http://192.168.1.7:19100/
SMPP_UGV_RUNTIME_MCP_PATH=/mcp
SMPP_UGV_RUNTIME_HEALTH_PATH=/health/ready

# Both external IDs are mandatory. Never select the first candidate in a list.
SMPP_UGV_EXTERNAL_PROVIDER_ID=isr.vehicle.ugv.ugv1
SMPP_UGV_EXTERNAL_SERVER_ID=production-ugv-direct-1
SMPP_UGV_RUNTIME_CREDENTIAL_REF=unauthenticated://none
SMPP_UGV_RUNTIME_TOKEN=
SMPP_UGV_RUNTIME_TOKEN_FILE=

# Stable SDAR-local identities for the exact Registry tuple. They never replace external IDs.
SDAR_UGV_LOCAL_SERVER_ID=ugv-smpp-runtime
SDAR_UGV_BINDING_ID=mcp-binding-ugv-smpp
SDAR_UGV_PROVIDER_DISPLAY_NAME=UGV SMPP Runtime
SDAR_UGV_PROVIDER_REPORT_FILE=reports/sdar-ugv-smpp-integration/provider-materialization.redacted.json

# These are SDAR's local management endpoint and a disposable absolute package workspace. They are
# not the external UGV Runtime endpoint. The full bootstrap wrapper remains blocked until Provider
# materialization and model bootstrap are composed, so leaving the workspace empty is safe.
SDAR_UGV_RUNTIME_MANAGEMENT_BASE_URL=http://127.0.0.1:9998
SDAR_UGV_GOVERNANCE_PACKAGE_ROOT=
SDAR_UGV_GOVERNANCE_REPORT_FILE=reports/sdar-ugv-smpp-integration/capability-skill-governance.redacted.json

# Deterministic read-only qualification. The deployed UGV adapter currently advertises only the
# simulation execution mode; the run still traverses the real PMS projection and deployed Runtime.
SDAR_UGV_READ_RUN_ID=
SDAR_UGV_READ_MODE=execute
SDAR_UGV_EXECUTION_MODE=simulation
SDAR_UGV_SIMULATION_ID=
SDAR_UGV_DETERMINISTIC_CHECKPOINT_FILE=reports/sdar-ugv-smpp-integration/deterministic-readonly.checkpoint.json
SDAR_UGV_RESTART_EVIDENCE_ID=
SDAR_UGV_DETERMINISTIC_REPORT_FILE=reports/sdar-ugv-smpp-integration/deterministic-readonly.json

# Real supported Model Provider. The local Home-Lab fixture is not acceptance authority.
SDAR_UGV_REAL_MODEL_ENABLED=NO
SDAR_UGV_MODEL_PROVIDER_ID=
SDAR_UGV_MODEL_BASE_URL=
SDAR_UGV_MODEL_NAME=
SDAR_UGV_MODEL_EMBEDDING_NAME=
# Optional; defaults to ${SDAR_UGV_MODEL_PROVIDER_ID}-embedding.
SDAR_UGV_MODEL_EMBEDDING_PROVIDER_ID=
# Optional; defaults to SDAR_UGV_MODEL_BASE_URL.
SDAR_UGV_MODEL_EMBEDDING_BASE_URL=
# Supported: openai_chat_completions or anthropic_messages
SDAR_UGV_MODEL_API_STYLE=
SDAR_UGV_MODEL_API_KEY=
SDAR_UGV_MODEL_API_KEY_FILE=
SDAR_UGV_MODEL_CONFORMANCE_RUN_ID=
SDAR_UGV_MODEL_CONFORMANCE_REPORT_FILE=reports/sdar-ugv-smpp-integration/model-stage-conformance.json
SDAR_A2A_URL=http://127.0.0.1:9999
SDAR_UGV_A2A_RUN_ID=
SDAR_UGV_A2A_POLL_INTERVAL_MS=1000
SDAR_UGV_A2A_MAX_POLLS=120
SDAR_UGV_A2A_REPORT_FILE=reports/sdar-ugv-smpp-integration/a2a-readonly.json
SDAR_UGV_PREFLIGHT_TIMEOUT_MS=15000

# Optional exact-control-authority remediation entry point for a previously contaminated local DB.
SDAR_UGV_REMEDIATION_RUN_ID=
SDAR_UGV_REMEDIATION_REPORT_FILE=reports/sdar-ugv-smpp-integration/control-authority-remediation.redacted.json

# Real-write gates are CLOSED by default. Empty target/run/distance values cannot move the UGV.
ALLOW_REAL_UGV_SIDE_EFFECTS=NO
REAL_UGV_TEST_RUN_ID=
UGV_TEST_RESOURCE_ID=
UGV_TEST_DISTANCE_M=
UGV_SITE_DISTANCE_LIMIT_M=2
UGV_CONTROL_REQUEST_KIND=bounded_movement

# Coordinates and reconnaissance require separate explicit operator gates and fixtures.
ALLOW_UGV_COORDINATE_NAVIGATION=NO
UGV_TEST_SAFE_POINT_JSON=
UGV_TEST_SAFE_WAYPOINTS_JSON=
ALLOW_REAL_UGV_RECON=NO
UGV_TEST_RECON_REGION_JSON=

# Intentionally no ALLOW_REAL_UGV_FIRE variable exists. Fire/weapon requests are always rejected.
