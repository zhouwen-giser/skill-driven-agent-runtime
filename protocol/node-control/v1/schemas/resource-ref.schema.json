{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdar.io/node-control/v1/ResourceRef.schema.json",
  "title": "ResourceRef",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id"
  ],
  "properties": {
    "type": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    }
  }
}
