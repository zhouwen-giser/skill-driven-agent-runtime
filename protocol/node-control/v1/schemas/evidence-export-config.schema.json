{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdar.io/node-control/v1/EvidenceExportConfiguration.schema.json",
  "title": "EvidenceExportConfiguration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exportId",
    "endpointRef",
    "sourceId",
    "credentialRef",
    "includedFamilies",
    "batchPolicy",
    "retryPolicy",
    "outboxPolicy",
    "redactionProfile",
    "artifactMode",
    "status",
    "revision"
  ],
  "properties": {
    "exportId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "endpointRef": { "type": "string", "pattern": "^https?://" },
    "sourceId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "nodeId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "credentialRef": {
      "type": "string",
      "pattern": "^(env|secret):[A-Za-z0-9_.:/-]{1,256}$"
    },
    "includedFamilies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "runtime",
          "skill",
          "mcp_task",
          "capability",
          "experience",
          "replay",
          "artifact",
          "node_control",
          "evidence"
        ]
      }
    },
    "excludedDiagnosticTypes": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "batchPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxRecords", "maxBytes", "flushIntervalMs"],
      "properties": {
        "maxRecords": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "maxBytes": { "type": "integer", "minimum": 1024, "maximum": 262144 },
        "flushIntervalMs": { "type": "integer", "minimum": 10, "maximum": 3600000 }
      }
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseDelayMs", "maxDelayMs"],
      "properties": {
        "baseDelayMs": { "type": "integer", "minimum": 10, "maximum": 300000 },
        "maxDelayMs": { "type": "integer", "minimum": 10, "maximum": 86400000 },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "outboxPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxPendingRecords", "retentionDays"],
      "properties": {
        "maxPendingRecords": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "retentionDays": { "type": "integer", "minimum": 1, "maximum": 3650 }
      }
    },
    "redactionProfile": { "type": "string", "minLength": 1, "maxLength": 256 },
    "artifactMode": { "enum": ["inline", "reference"] },
    "status": { "enum": ["draft", "active", "suspended", "retired"] },
    "revision": { "type": "integer", "minimum": 1 },
    "applyMode": { "enum": ["hot_reload", "reconnect_required", "restart_required"] }
  }
}
