{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdar.io/node-control/v1/EvidenceExportStatus.schema.json",
  "title": "EvidenceExportStatus",
  "type": "object",
  "additionalProperties": false,
  "required": ["exportId", "status", "pendingRecords", "observedAt"],
  "properties": {
    "exportId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["healthy", "degraded", "blocked", "disabled", "unavailable"] },
    "activeRevision": { "type": "integer", "minimum": 0 },
    "lastAcknowledgedSequence": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "pendingRecords": { "type": "integer", "minimum": 0 },
    "oldestPendingAt": { "type": "string", "format": "date-time" },
    "lastAcknowledgedAt": { "type": "string", "format": "date-time" },
    "lastErrorCode": { "type": "string" },
    "lastErrorAt": { "type": "string", "format": "date-time" },
    "observedAt": { "type": "string", "format": "date-time" }
  }
}
