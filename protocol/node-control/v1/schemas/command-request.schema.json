{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sdar.io/node-control/v1/CommandRequest.schema.json",
  "title": "CommandRequest",
  "type": "object",
  "additionalProperties": false,
