{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdar.local/protocol/mcp-server-discover.schema.json",
  "title": "SDAR Frozen MCP server/discover Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["resultType", "supportedVersions", "capabilities", "_meta"],
  "properties": {
    "resultType": { "const": "complete" },
    "supportedVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": { "const": "2026-07-28" },
      "items": { "type": "string" }
    },
    "capabilities": {
      "type": "object",
      "required": ["extensions"],
      "properties": {
        "tools": { "type": "object" },
        "extensions": {
          "type": "object",
          "required": ["io.modelcontextprotocol/tasks", "io.sdar/taskExecution"],
          "properties": {
            "io.modelcontextprotocol/tasks": { "type": "object" },
            "io.sdar/taskExecution": {
              "type": "object",
              "additionalProperties": false,
              "required": ["profileVersion", "taskNotifications"],
              "properties": {
                "profileVersion": { "const": "1.0" },
                "taskNotifications": { "const": true }
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "_meta": {
      "type": "object",
      "required": ["io.modelcontextprotocol/serverInfo"],
      "properties": {
        "io.modelcontextprotocol/serverInfo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "version": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        }
      },
      "additionalProperties": true
    },
    "instructions": { "type": "string", "maxLength": 8192 },
    "ttlMs": { "type": "integer", "minimum": 0 },
    "cacheScope": { "type": "string" }
  }
}
