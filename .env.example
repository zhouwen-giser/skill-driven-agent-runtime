# Development 唯一完整配置模板；不要在此文件填写实际秘密。
# ./deploy/development/deploy.sh init 生成私有 deploy/development/.env，已有文件不覆盖。
# 优先级：CLI --set=KEY=value > 进程环境 > --env-file 文件 > 部署默认值。
# dotenv 仅作为数据读取，不 source，不展开 $VAR；含 #/空格/JSON 的值使用引号。
# secret://env/NAME 引用支持部署自选环境变量名：在私有 .env 中声明同名项，进程环境可覆盖；这些任意凭据变量不在通用模板枚举。
# 注释项表示未设置；可选项请保留注释，而不是盲目设置为空（枚举/URL 空值会拒绝）。
# 本文默认值指部署默认值；直接 Node 启动的历史默认值以对应服务 environment.ts 为准。
# 所有配置修改需重启作用服务；密码/加密主密钥修改还需独立迁移，升级不自动轮换。
# Compose *_PORT 是宿主机映射；内部固定 runtime:10998/10999、control-api:10091、postgres/control-postgres:5432、redis:6379。
# Compose 内部地址自动覆盖；公开 URL 由 PUBLIC_HOST 生成，不公布容器名或 0.0.0.0。
# 仅可信开发网：公开接口免 Bearer，数据库/Redis 虽对外开放仍需密码。不要部署到公网。
# 非武器副作用 YES；武器/效应器 Device 执行不可用，软件演示必须人工确认。

# allow ugv live side effects 配置；读取方见服务栏及对应 environment.ts
# 类型=string；默认=YES；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
ALLOW_UGV_LIVE_SIDE_EFFECTS=YES

# allow ugv simulation side effects 配置；读取方见服务栏及对应 environment.ts
# 类型=string；默认=YES；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
ALLOW_UGV_SIMULATION_SIDE_EFFECTS=YES

# business events enabled 配置；读取方见服务栏及对应 environment.ts
# 类型=enum；默认=false；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
BUSINESS_EVENTS_ENABLED=false

# business events max subscriptions 配置；读取方见服务栏及对应 environment.ts
# 类型=number；默认=256；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
BUSINESS_EVENTS_MAX_SUBSCRIPTIONS=256

# business events poll interval ms 配置；读取方见服务栏及对应 environment.ts
# 类型=number；默认=500；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
BUSINESS_EVENTS_POLL_INTERVAL_MS=500

# business events required for runtime ready 配置；读取方见服务栏及对应 environment.ts
# 类型=enum；默认=false；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
BUSINESS_EVENTS_REQUIRED_FOR_RUNTIME_READY=false

# node env 配置；读取方见服务栏及对应 environment.ts
# 类型=string；默认=development；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
NODE_ENV=development

# a2a host 监听/连接主机
# 类型=string；默认=0.0.0.0；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_A2A_HOST=0.0.0.0

# a2a port 宿主机端口（1..65535）；内部端口见顶部说明
# 类型=number；默认=10999；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_A2A_PORT=10999

# Agent Card 公共 HTTP(S) origin；默认由 public host 和映射端口生成
# 类型=string；默认=无（未设置）；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
# SDAR_A2A_PUBLIC_BASE_URL=

# a2a wait timeout ms 配置；读取方见服务栏及对应 environment.ts
# 类型=number；默认=30000；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_A2A_WAIT_TIMEOUT_MS=30000

# acknowledge no auth network exposure 配置；读取方见服务栏及对应 environment.ts
# 类型=enum；默认=true；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_ACKNOWLEDGE_NO_AUTH_NETWORK_EXPOSURE=true

# artifact management actor id 配置；读取方见服务栏及对应 environment.ts
# 类型=string；默认=development-administrator；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_ARTIFACT_MANAGEMENT_ACTOR_ID=development-administrator

# artifact management bearer token 服务/管理身份凭据；init 生成相应 internal 凭据
# 类型=secret string；默认=无（未设置）；必填=init 生成或对应功能启用时配置；服务=Runtime；敏感=是；重启=是
# SDAR_ARTIFACT_MANAGEMENT_BEARER_TOKEN=replace_private_value

# artifact management kind 配置；读取方见服务栏及对应 environment.ts
# 类型=string；默认=human；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_ARTIFACT_MANAGEMENT_KIND=human

# artifact management roles 配置；读取方见服务栏及对应 environment.ts
# 类型=string；默认=administrator；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_ARTIFACT_MANAGEMENT_ROLES=administrator

# artifact management tenant id 配置；读取方见服务栏及对应 environment.ts
# 类型=string；默认=无（未设置）；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
# SDAR_ARTIFACT_MANAGEMENT_TENANT_ID=

# cognitive management bearer token 服务/管理身份凭据；init 生成相应 internal 凭据
# 类型=secret string；默认=无（未设置）；必填=init 生成或对应功能启用时配置；服务=Runtime；敏感=是；重启=是
# SDAR_COGNITIVE_MANAGEMENT_BEARER_TOKEN=replace_private_value

# 仅 Vite 开发端口
# 类型=number；默认=5173；必填=可选，特殊条件见用途；服务=Vite；敏感=否；重启=是
SDAR_CONSOLE_DEV_PORT=5173

# 仅 Vite 开发 /api 代理；生产静态 Console 随 Management 提供
# 类型=string；默认=http://127.0.0.1:10998；必填=可选，特殊条件见用途；服务=Vite；敏感=否；重启=是
SDAR_CONSOLE_DEV_PROXY_URL=http://127.0.0.1:10998

# control a2a agent card url 地址（无凭据 HTTP(S) URL），Compose 默认自动生成
# 类型=string；默认=无（未设置）；必填=可选，特殊条件见用途；服务=Control API/worker；敏感=否；重启=是
# SDAR_CONTROL_A2A_AGENT_CARD_URL=

# control acknowledge private http endpoints 配置；读取方见服务栏及对应 environment.ts
# 类型=enum；默认=无（未设置）；必填=可选，特殊条件见用途；服务=Control API/worker；敏感=否；重启=是
# SDAR_CONTROL_ACKNOWLEDGE_PRIVATE_HTTP_ENDPOINTS=

# control api host 监听/连接主机
# 类型=string；默认=0.0.0.0；必填=可选，特殊条件见用途；服务=Control API/worker；敏感=否；重启=是
SDAR_CONTROL_API_HOST=0.0.0.0

# control api port 宿主机端口（1..65535）；内部端口见顶部说明
# 类型=number；默认=10091；必填=可选，特殊条件见用途；服务=Control API/worker；敏感=否；重启=是
SDAR_CONTROL_API_PORT=10091

# control api token 服务/管理身份凭据；init 生成相应 internal 凭据
# 类型=secret string；默认=无（未设置）；必填=init 生成或对应功能启用时配置；服务=Control API/worker；敏感=是；重启=是
# SDAR_CONTROL_API_TOKEN=replace_private_value

# Control PG 连接串；Compose 自动生成 control-postgres:5432
# 类型=secret string；默认=无（未设置）；必填=init 生成或对应功能启用时配置；服务=Control API/worker；敏感=是；重启=是
# SDAR_CONTROL_DATABASE_URL=replace_private_value

# control environment 配置；读取方见服务栏及对应 environment.ts
# 类型=string；默认=development；必填=可选，特殊条件见用途；服务=Control API/worker；敏感=否；重启=是
SDAR_CONTROL_ENVIRONMENT=development

# control mcp endpoint allowlist 配置；读取方见服务栏及对应 environment.ts
# 类型=string；默认=无（未设置）；必填=可选，特殊条件见用途；服务=Control API/worker；敏感=否；重启=是
# SDAR_CONTROL_MCP_ENDPOINT_ALLOWLIST=

# control node display name 配置；读取方见服务栏及对应 environment.ts
# 类型=string；默认=Development SDAR；必填=可选，特殊条件见用途；服务=Control API/worker；敏感=否；重启=是
SDAR_CONTROL_NODE_DISPLAY_NAME=Development SDAR

# control node events url 地址（无凭据 HTTP(S) URL），Compose 默认自动生成
# 类型=string；默认=无（未设置）；必填=可选，特殊条件见用途；服务=Control API/worker；敏感=否；重启=是
# SDAR_CONTROL_NODE_EVENTS_URL=

# control node id 配置；读取方见服务栏及对应 environment.ts
# 类型=string；默认=development-sdar-node；必填=可选，特殊条件见用途；服务=Control API/worker；敏感=否；重启=是
SDAR_CONTROL_NODE_ID=development-sdar-node

# control node type 配置；读取方见服务栏及对应 environment.ts
# 类型=string；默认=sdar-runtime；必填=可选，特殊条件见用途；服务=Control API/worker；敏感=否；重启=是
SDAR_CONTROL_NODE_TYPE=sdar-runtime

# control operator api token 服务/管理身份凭据；init 生成相应 internal 凭据
# 类型=secret string；默认=无（未设置）；必填=init 生成或对应功能启用时配置；服务=Control API/worker；敏感=是；重启=是
# SDAR_CONTROL_OPERATOR_API_TOKEN=replace_private_value

# control organization api token 服务/管理身份凭据；init 生成相应 internal 凭据
# 类型=secret string；默认=无（未设置）；必填=init 生成或对应功能启用时配置；服务=Control API/worker；敏感=是；重启=是
# SDAR_CONTROL_ORGANIZATION_API_TOKEN=replace_private_value

# control organization tenant id 配置；读取方见服务栏及对应 environment.ts
# 类型=string；默认=无（未设置）；必填=可选，特殊条件见用途；服务=Control API/worker；敏感=否；重启=是
# SDAR_CONTROL_ORGANIZATION_TENANT_ID=

# unsafe_test_open=可信开发网络；safe=原出站策略
# 类型=string；默认=unsafe_test_open；必填=可选，特殊条件见用途；服务=Control API/worker；敏感=否；重启=是
SDAR_CONTROL_OUTBOUND_ENDPOINT_POLICY=unsafe_test_open

# control postgres db 配置；读取方见服务栏及对应 environment.ts
# 类型=string；默认=sdar_control；必填=可选，特殊条件见用途；服务=部署 CLI；敏感=否；重启=是
SDAR_CONTROL_POSTGRES_DB=sdar_control

# control postgres password 数据库密码，init 自动生成，已有卷不能只改 env 轮换
# 类型=secret string；默认=无（未设置）；必填=init 生成或对应功能启用时配置；服务=部署 CLI；敏感=是；重启=是
# SDAR_CONTROL_POSTGRES_PASSWORD=replace_private_value

# control postgres port 宿主机端口（1..65535）；内部端口见顶部说明
# 类型=number；默认=55463；必填=可选，特殊条件见用途；服务=部署 CLI；敏感=否；重启=是
SDAR_CONTROL_POSTGRES_PORT=55463

# control postgres user 配置；读取方见服务栏及对应 environment.ts
# 类型=string；默认=sdar_control；必填=可选，特殊条件见用途；服务=部署 CLI；敏感=否；重启=是
SDAR_CONTROL_POSTGRES_USER=sdar_control

# control private http endpoint allowlist 配置；读取方见服务栏及对应 environment.ts
# 类型=string；默认=无（未设置）；必填=可选，特殊条件见用途；服务=Control API/worker；敏感=否；重启=是
# SDAR_CONTROL_PRIVATE_HTTP_ENDPOINT_ALLOWLIST=

# control provider endpoint allowlist 配置；读取方见服务栏及对应 environment.ts
# 类型=string；默认=无（未设置）；必填=可选，特殊条件见用途；服务=Control API/worker；敏感=否；重启=是
# SDAR_CONTROL_PROVIDER_ENDPOINT_ALLOWLIST=

# control public url 地址（无凭据 HTTP(S) URL），Compose 默认自动生成
# 类型=string；默认=无（未设置）；必填=可选，特殊条件见用途；服务=Control API/worker；敏感=否；重启=是
# SDAR_CONTROL_PUBLIC_URL=

# control rate limit per minute 配置；读取方见服务栏及对应 environment.ts
# 类型=number；默认=1200；必填=可选，特殊条件见用途；服务=Control API/worker；敏感=否；重启=是
SDAR_CONTROL_RATE_LIMIT_PER_MINUTE=1200

# control request body limit kb 配置；读取方见服务栏及对应 environment.ts
# 类型=number；默认=64；必填=可选，特殊条件见用途；服务=Control API/worker；敏感=否；重启=是
SDAR_CONTROL_REQUEST_BODY_LIMIT_KB=64

# Control 访问 Runtime PG 连接串；Compose 自动生成
# 类型=secret string；默认=无（未设置）；必填=init 生成或对应功能启用时配置；服务=Control API/worker；敏感=是；重启=是
# SDAR_CONTROL_RUNTIME_DATABASE_URL=replace_private_value

# Control→Runtime 内部 URL；Compose 固定 http://runtime:10998
# 类型=string；默认=无（未设置）；必填=可选，特殊条件见用途；服务=Control API/worker；敏感=否；重启=是
# SDAR_CONTROL_RUNTIME_ENDPOINT_REF=

# control runtime service token 服务/管理身份凭据；init 生成相应 internal 凭据
# 类型=secret string；默认=无（未设置）；必填=init 生成或对应功能启用时配置；服务=Control API/worker；敏感=是；重启=是
# SDAR_CONTROL_RUNTIME_SERVICE_TOKEN=replace_private_value

# control security api token 服务/管理身份凭据；init 生成相应 internal 凭据
# 类型=secret string；默认=无（未设置）；必填=init 生成或对应功能启用时配置；服务=Control API/worker；敏感=是；重启=是
# SDAR_CONTROL_SECURITY_API_TOKEN=replace_private_value

# control viewer api token 服务/管理身份凭据；init 生成相应 internal 凭据
# 类型=secret string；默认=无（未设置）；必填=init 生成或对应功能启用时配置；服务=Control API/worker；敏感=是；重启=是
# SDAR_CONTROL_VIEWER_API_TOKEN=replace_private_value

# control worker once 配置；读取方见服务栏及对应 environment.ts
# 类型=enum；默认=false；必填=可选，特殊条件见用途；服务=Control API/worker；敏感=否；重启=是
SDAR_CONTROL_WORKER_ONCE=false

# control worker poll ms 配置；读取方见服务栏及对应 environment.ts
# 类型=number；默认=1000；必填=可选，特殊条件见用途；服务=Control API/worker；敏感=否；重启=是
SDAR_CONTROL_WORKER_POLL_MS=1000

# 宿主机监听地址，0.0.0.0 对外开放
# 类型=string；默认=0.0.0.0；必填=可选，特殊条件见用途；服务=部署 CLI；敏感=否；重启=是
SDAR_DEPLOY_BIND_HOST=0.0.0.0

# 构建输出镜像标签
# 类型=string；默认=sdar-development:local；必填=可选，特殊条件见用途；服务=部署 CLI；敏感=否；重启=是
SDAR_DEPLOY_IMAGE=sdar-development:local

# 联网构建 Node 基础镜像
# 类型=string；默认=node:22.23.1-bookworm-slim；必填=可选，特殊条件见用途；服务=部署 CLI；敏感=否；重启=是
SDAR_DEPLOY_NODE_IMAGE=node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3

# Compose 项目/卷归属；升级保持不变
# 类型=string；默认=sdar-development；必填=可选，特殊条件见用途；服务=部署 CLI；敏感=否；重启=是
SDAR_DEPLOY_PROJECT=sdar-development

# 可选已构建 PostgreSQL 17 + pgvector 0.8.5 镜像（推荐 digest）；空值使用随包固定源配方构建。
# 类型=string；默认=空；必填=否；服务=部署 CLI；敏感=否；重启=是
SDAR_DEPLOY_POSTGRES_IMAGE=

# 客户端可达域名/IPv4，替换 localhost；用于所有公开 URL
# 类型=string；默认=localhost；必填=可选，特殊条件见用途；服务=部署 CLI；敏感=否；重启=是
SDAR_DEPLOY_PUBLIC_HOST=localhost

# 相对 .env 的私密持久目录；不要使用 /tmp
# 类型=string；默认=.state；必填=可选，特殊条件见用途；服务=部署 CLI；敏感=否；重启=是
SDAR_DEPLOY_STATE_DIR=.state

# auto_non_weapon=部署所有者预授权；manual=交互确认；不自动确认模拟武器
# 类型=string；默认=auto_non_weapon；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_DEVELOPMENT_CONFIRMATION_POLICY=auto_non_weapon

# open=开发公共接口免 Bearer，internal 仍鉴权；off=原访问策略
# 类型=string；默认=open；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_DEVELOPMENT_PUBLIC_ACCESS=open

# 直接启动 Node 的 dotenv 文件路径；CLI 使用 --env-file；不执行 shell
# 类型=string；默认=无（未设置）；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
# SDAR_ENV_FILE=

# JSON 对象，精确包含 tenantId/projectId，例如 '{"tenantId":"dev","projectId":"demo"}'
# 类型=JSON；默认=无（未设置）；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
# SDAR_EVIDENCE_OBSERVATION_SCOPE=

# 部署授权所有者 ID；自动确认不伪装逐任务人工点击
# 类型=string；默认=human:development-deployment-owner；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_GOVERNED_CONTROL_ACTOR_ID=human:development-deployment-owner

# trusted_intranet=开发网确认；bearer=显式凭据
# 类型=string；默认=trusted_intranet；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_GOVERNED_CONTROL_AUTHENTICATION_MODE=trusted_intranet

# governed control bearer token 服务/管理身份凭据；init 生成相应 internal 凭据
# 类型=secret string；默认=无（未设置）；必填=init 生成或对应功能启用时配置；服务=Runtime；敏感=是；重启=是
# SDAR_GOVERNED_CONTROL_BEARER_TOKEN=replace_private_value

# 非武器物理确认/撤销/急停权限逗号列表
# 类型=string；默认=physical_control.confirm,physical_control.revoke,physical_control.emergency_stop；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_GOVERNED_CONTROL_PERMISSIONS=physical_control.confirm,physical_control.revoke,physical_control.emergency_stop

# management host 监听/连接主机
# 类型=string；默认=0.0.0.0；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_MANAGEMENT_HOST=0.0.0.0

# management port 宿主机端口（1..65535）；内部端口见顶部说明
# 类型=number；默认=10998；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_MANAGEMENT_PORT=10998

# 32 随机字节 Base64 主密钥，init 自动生成；升级保留，不允许直接轮换
# 类型=secret string；默认=无（未设置）；必填=init 生成或对应功能启用时配置；服务=Runtime；敏感=是；重启=是
# SDAR_MASTER_KEY_BASE64=replace_private_value

# emit/omit 是否发送 live 模式 MCP 请求头
# 类型=string；默认=emit；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_MCP_LIVE_EXECUTION_MODE_HEADER=emit

# Runtime→Control 内部 origin；Compose 固定 http://control-api:10091
# 类型=string；默认=无（未设置）；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
# SDAR_NODE_CONTROL_BASE_URL=

# Runtime→Control 只读凭据，由 VIEWER_API_TOKEN 自动对齐
# 类型=secret string；默认=无（未设置）；必填=init 生成或对应功能启用时配置；服务=Runtime；敏感=是；重启=是
# SDAR_NODE_CONTROL_EVIDENCE_SERVICE_TOKEN=replace_private_value

# postgres db 配置；读取方见服务栏及对应 environment.ts
# 类型=string；默认=sdar；必填=可选，特殊条件见用途；服务=部署 CLI；敏感=否；重启=是
SDAR_POSTGRES_DB=sdar

# postgres password 数据库密码，init 自动生成，已有卷不能只改 env 轮换
# 类型=secret string；默认=无（未设置）；必填=init 生成或对应功能启用时配置；服务=部署 CLI；敏感=是；重启=是
# SDAR_POSTGRES_PASSWORD=replace_private_value

# postgres port 宿主机端口（1..65535）；内部端口见顶部说明
# 类型=number；默认=55462；必填=可选，特殊条件见用途；服务=部署 CLI；敏感=否；重启=是
SDAR_POSTGRES_PORT=55462

# Runtime PG 完整连接串；Compose 自动生成 postgres:5432，密码 URL 编码
# 类型=secret string；默认=无（未设置）；必填=init 生成或对应功能启用时配置；服务=Runtime；敏感=是；重启=是
# SDAR_POSTGRES_URL=replace_private_value

# postgres user 配置；读取方见服务栏及对应 environment.ts
# 类型=string；默认=sdar；必填=可选，特殊条件见用途；服务=部署 CLI；敏感=否；重启=是
SDAR_POSTGRES_USER=sdar

# 所有 Redis/Bull 连接的逻辑库编号 0..15
# 类型=number；默认=0；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_REDIS_DB=0

# redis host 监听/连接主机
# 类型=string；默认=无（未设置）；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
# SDAR_REDIS_HOST=

# 所有 Redis/Bull worker 共用密码，init 自动生成；带空格/# 请加引号
# 类型=secret string；默认=无（未设置）；必填=init 生成或对应功能启用时配置；服务=Runtime；敏感=是；重启=是
# SDAR_REDIS_PASSWORD=replace_private_value

# redis port 宿主机端口（1..65535）；内部端口见顶部说明
# 类型=number；默认=56391；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_REDIS_PORT=56391

# reuse existing infra 历史联调参数，不成为日常部署前置
# 类型=string；默认=无（未设置）；必填=可选，特殊条件见用途；服务=历史测试脚本（部署不读取）；敏感=否；重启=是
# SDAR_REUSE_EXISTING_INFRA=

# Runtime internal 凭据，由 CONTROL_RUNTIME_SERVICE_TOKEN 自动对齐
# 类型=secret string；默认=无（未设置）；必填=init 生成或对应功能启用时配置；服务=Runtime；敏感=是；重启=是
# SDAR_RUNTIME_CONTROL_SERVICE_TOKEN=replace_private_value

# 任务理解 profile：ugv-agent-profile/off/managed_capability/home_lab_read_only/home_lab_governed_light_control
# 类型=string；默认=ugv-agent-profile；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_TASK_UNDERSTANDING_PROFILE=ugv-agent-profile

# ugv a2a max polls 历史联调参数，不成为日常部署前置
# 类型=string；默认=无（未设置）；必填=可选，特殊条件见用途；服务=历史测试脚本（部署不读取）；敏感=否；重启=是
# SDAR_UGV_A2A_MAX_POLLS=

# ugv a2a poll interval ms 历史联调参数，不成为日常部署前置
# 类型=number；默认=无（未设置）；必填=可选，特殊条件见用途；服务=历史测试脚本（部署不读取）；敏感=否；重启=是
# SDAR_UGV_A2A_POLL_INTERVAL_MS=

# ugv a2a report file 历史联调参数，不成为日常部署前置
# 类型=string；默认=无（未设置）；必填=可选，特殊条件见用途；服务=历史测试脚本（部署不读取）；敏感=否；重启=是
# SDAR_UGV_A2A_REPORT_FILE=

# ugv a2a run id 历史联调参数，不成为日常部署前置
# 类型=string；默认=无（未设置）；必填=可选，特殊条件见用途；服务=历史测试脚本（部署不读取）；敏感=否；重启=是
# SDAR_UGV_A2A_RUN_ID=

# ugv binding id 配置；读取方见服务栏及对应 environment.ts
# 类型=string；默认=development-ugv-binding；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_UGV_BINDING_ID=development-ugv-binding

# YES=正式治理初始化；NO=外部 Provider 未配置，明确不可用
# 类型=enum；默认=NO；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_UGV_BOOTSTRAP_ENABLED=NO

# Provider 声明的 live/simulation，与物理确认独立
# 类型=string；默认=live；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_UGV_EXECUTION_MODE=live

# Registry Provider 精确 ID，bootstrap=YES 必填
# 类型=string；默认=无（未设置）；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
# SDAR_UGV_EXTERNAL_PROVIDER_ID=

# Registry Server 精确 ID，bootstrap=YES 必填
# 类型=string；默认=无（未设置）；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
# SDAR_UGV_EXTERNAL_SERVER_ID=

# 模型密钥；模型启用时与 API_KEY_FILE 二选一
# 类型=secret string；默认=无（未设置）；必填=init 生成或对应功能启用时配置；服务=Runtime；敏感=是；重启=是
# SDAR_UGV_MODEL_API_KEY=replace_private_value

# 模型密钥文件，与 API_KEY 二选一；相对 .env，部署只读挂载，不打包
# 类型=string；默认=无（未设置）；必填=启用模型时按上述条件；服务=Runtime；敏感=否；重启=是
# SDAR_UGV_MODEL_API_KEY_FILE=

# 模型接口风格 openai_chat_completions/anthropic_messages
# 类型=string；默认=无（未设置）；必填=启用模型时按上述条件；服务=Runtime；敏感=否；重启=是
# SDAR_UGV_MODEL_API_STYLE=

# ugv model base url 地址（无凭据 HTTP(S) URL），Compose 默认自动生成
# 类型=string；默认=无（未设置）；必填=启用模型时按上述条件；服务=Runtime；敏感=否；重启=是
# SDAR_UGV_MODEL_BASE_URL=

# ugv model conformance report file 历史联调参数，不成为日常部署前置
# 类型=string；默认=无（未设置）；必填=启用模型时按上述条件；服务=历史测试脚本（部署不读取）；敏感=否；重启=是
# SDAR_UGV_MODEL_CONFORMANCE_REPORT_FILE=

# 默认主模型 base URL；设置须同时填 embedding name
# 类型=string；默认=无（未设置）；必填=启用模型时按上述条件；服务=Runtime；敏感=否；重启=是
# SDAR_UGV_MODEL_EMBEDDING_BASE_URL=

# 可选 embedding 模型，仅 OpenAI 兼容 API
# 类型=string；默认=无（未设置）；必填=启用模型时按上述条件；服务=Runtime；敏感=否；重启=是
# SDAR_UGV_MODEL_EMBEDDING_NAME=

# 默认主 Provider ID 后缀 -embedding；设置须同时填 embedding name
# 类型=string；默认=无（未设置）；必填=启用模型时按上述条件；服务=Runtime；敏感=否；重启=是
# SDAR_UGV_MODEL_EMBEDDING_PROVIDER_ID=

# ugv model name 配置；读取方见服务栏及对应 environment.ts
# 类型=string；默认=无（未设置）；必填=启用模型时按上述条件；服务=Runtime；敏感=否；重启=是
# SDAR_UGV_MODEL_NAME=

# ugv model provider id 配置；读取方见服务栏及对应 environment.ts
# 类型=string；默认=无（未设置）；必填=启用模型时按上述条件；服务=Runtime；敏感=否；重启=是
# SDAR_UGV_MODEL_PROVIDER_ID=

# ugv model timeout ms 配置；读取方见服务栏及对应 environment.ts
# 类型=number；默认=30000；必填=启用模型时按上述条件；服务=Runtime；敏感=否；重启=是
SDAR_UGV_MODEL_TIMEOUT_MS=30000

# YES=从环境初始化模型 Provider/阶段路由，已有配置不覆盖；NO=不初始化模型
# 类型=enum；默认=NO；必填=启用模型时按上述条件；服务=Runtime；敏感=否；重启=是
SDAR_UGV_REAL_MODEL_ENABLED=NO

# sdar-registry-v1 Registry URL；BOOTSTRAP_ENABLED=YES 必填，不复用历史 checksum
# 类型=string；默认=无（未设置）；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
# SDAR_UGV_REGISTRY_ENDPOINT=

# Registry 发布环境；不要求与 Runtime development 同名
# 类型=string；默认=development；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_UGV_REGISTRY_ENVIRONMENT=development

# ugv resource id 配置；读取方见服务栏及对应 environment.ts
# 类型=string；默认=vehicle:ugv1；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_UGV_RESOURCE_ID=vehicle:ugv1

# ugv server id 配置；读取方见服务栏及对应 environment.ts
# 类型=string；默认=development-ugv；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_UGV_SERVER_ID=development-ugv

# 治理 Source 稳定 ID，bootstrap=YES 必填
# 类型=string；默认=无（未设置）；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
# SDAR_UGV_SOURCE_ID=

# v13 artifact allowlist Artifact 功能开关/列表，非 UGV 展示白名单
# 类型=string；默认=；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_V13_ARTIFACT_ALLOWLIST=

# v13 artifact mode Artifact 功能开关/列表，非 UGV 展示白名单
# 类型=string；默认=off；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_V13_ARTIFACT_MODE=off

# v13 case enabled Artifact 功能开关/列表，非 UGV 展示白名单
# 类型=enum；默认=false；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_V13_CASE_ENABLED=false

# v13 compiler enabled Artifact 功能开关/列表，非 UGV 展示白名单
# 类型=enum；默认=false；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_V13_COMPILER_ENABLED=false

# v13 fast gateway enabled Artifact 功能开关/列表，非 UGV 展示白名单
# 类型=enum；默认=false；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_V13_FAST_GATEWAY_ENABLED=false

# v13 model cascade enabled Artifact 功能开关/列表，非 UGV 展示白名单
# 类型=enum；默认=false；必填=启用模型时按上述条件；服务=Runtime；敏感=否；重启=是
SDAR_V13_MODEL_CASCADE_ENABLED=false

# v13 model route enabled Artifact 功能开关/列表，非 UGV 展示白名单
# 类型=enum；默认=false；必填=启用模型时按上述条件；服务=Runtime；敏感=否；重启=是
SDAR_V13_MODEL_ROUTE_ENABLED=false

# v13 promotion enabled Artifact 功能开关/列表，非 UGV 展示白名单
# 类型=enum；默认=false；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_V13_PROMOTION_ENABLED=false

# v13 registry enabled Artifact 功能开关/列表，非 UGV 展示白名单
# 类型=enum；默认=false；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_V13_REGISTRY_ENABLED=false

# v13 retrieval enabled Artifact 功能开关/列表，非 UGV 展示白名单
# 类型=enum；默认=false；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_V13_RETRIEVAL_ENABLED=false

# v13 rule enabled Artifact 功能开关/列表，非 UGV 展示白名单
# 类型=enum；默认=false；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_V13_RULE_ENABLED=false

# v13 shadow enabled Artifact 功能开关/列表，非 UGV 展示白名单
# 类型=enum；默认=false；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_V13_SHADOW_ENABLED=false

# v13 template enabled Artifact 功能开关/列表，非 UGV 展示白名单
# 类型=enum；默认=false；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_V13_TEMPLATE_ENABLED=false

# v13 tenant allowlist Artifact 功能开关/列表，非 UGV 展示白名单
# 类型=string；默认=；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
SDAR_V13_TENANT_ALLOWLIST=

# simulation 模式所需 simulationId；live 不携带
# 类型=string；默认=无（未设置）；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
# UGV_SIMULATION_RUN_ID=

# 历史命名、当前运行参数：最终位置最大年龄毫秒，1..3000
# 类型=number；默认=3000；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
UGV_TEST_MAX_FINAL_STATE_AGE_MS=3000

# 历史命名、当前运行参数：最小实际位移米，0<值<=2
# 类型=number；默认=0.5；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
UGV_TEST_MINIMUM_DISPLACEMENT_M=0.5

# 历史命名、当前运行参数：点导航到达容差米，0<值<=2
# 类型=number；默认=2；必填=可选，特殊条件见用途；服务=Runtime；敏感=否；重启=是
UGV_TEST_TOLERANCE_M=2
