# Local development only. Do not reuse these values in a shared or production environment.
SDAR_POSTGRES_DB=sdar
SDAR_POSTGRES_USER=sdar
SDAR_POSTGRES_PASSWORD=sdar_local_only
SDAR_POSTGRES_PORT=55432
SDAR_POSTGRES_URL=postgresql://sdar:sdar_local_only@127.0.0.1:55432/sdar
SDAR_REDIS_HOST=127.0.0.1
SDAR_REDIS_PORT=56379

SDAR_A2A_HOST=127.0.0.1
SDAR_A2A_PORT=9999
SDAR_MANAGEMENT_HOST=127.0.0.1
SDAR_MANAGEMENT_PORT=9998
SDAR_ACKNOWLEDGE_NO_AUTH_NETWORK_EXPOSURE=false

# Optional authenticated P12 Artifact management surface. When the token is set,
# actor ID and a comma-separated least-privilege role set are required.
# Tenant is optional; omit it only for an explicitly global operator.
# Supported kinds: human, service.
# Supported roles: viewer, operator, reviewer, approver, administrator, security_operator.
# SDAR_ARTIFACT_MANAGEMENT_BEARER_TOKEN=replace_with_at_least_32_non_whitespace_characters
# SDAR_ARTIFACT_MANAGEMENT_ACTOR_ID=artifact-operator
# SDAR_ARTIFACT_MANAGEMENT_TENANT_ID=tenant-example
# SDAR_ARTIFACT_MANAGEMENT_KIND=human
# SDAR_ARTIFACT_MANAGEMENT_ROLES=viewer,operator

# The runtime master key must be 32 random bytes encoded as base64.
# Generate it outside logs and never persist the real value in this file.
SDAR_MASTER_KEY_BASE64=replace_with_32_random_bytes_base64

# Set true only when an operator already started PostgreSQL and Redis and owns their lifecycle.
SDAR_REUSE_EXISTING_INFRA=false

# SDAR v1.3 Artifact runtime rollout controls. Every executable path is off by default.
SDAR_V13_ARTIFACT_MODE=off
SDAR_V13_COMPILER_ENABLED=false
SDAR_V13_REGISTRY_ENABLED=false
SDAR_V13_SHADOW_ENABLED=false
SDAR_V13_PROMOTION_ENABLED=false
SDAR_V13_RETRIEVAL_ENABLED=false
SDAR_V13_MODEL_ROUTE_ENABLED=false
SDAR_V13_TEMPLATE_ENABLED=false
SDAR_V13_RULE_ENABLED=false
SDAR_V13_FAST_GATEWAY_ENABLED=false
SDAR_V13_CASE_ENABLED=false
SDAR_V13_MODEL_CASCADE_ENABLED=false
# Comma-separated tenant IDs. Empty retains the frozen all-tenant behavior once other gates allow it.
SDAR_V13_TENANT_ALLOWLIST=
# Comma-separated exact versioned refs (artifactId:version). Empty denies every Artifact.
SDAR_V13_ARTIFACT_ALLOWLIST=
