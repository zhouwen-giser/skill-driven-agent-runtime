    "description": "Treat the admitted legal area as subregion-1, compose exact governed movement and inspection child Tasks, and require retained actual trajectory and scoped coverage for complete success.",
    "inputSchema": {
      "type": "object",
      "required": ["resourceId", "target", "area", "timeWindow"],
      "properties": {
        "area": {
          "type": "object",
          "required": ["boundary"],
          "properties": {
            "frame": {
              "enum": ["WGS84", "EPSG:4326"],
              "type": "string"
            },
            "boundary": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["x", "y"],
                "properties": {
                  "x": {
                    "type": "number",
                    "maximum": 180,
                    "minimum": -180
                  },
                  "y": {
                    "type": "number",
                    "maximum": 90,
                    "minimum": -90
                  }
                },
                "additionalProperties": false
              },
              "maxItems": 257,
              "minItems": 3
            },
            "excludedZones": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 0
            }
          },
          "additionalProperties": false
        },
        "target": {
          "type": "object",
          "required": ["x", "y", "frame"],
          "properties": {
            "x": {
              "type": "number",
              "maximum": 180,
              "minimum": -180
            },
            "y": {
              "type": "number",
              "maximum": 90,
              "minimum": -90
            },
            "frame": {
              "type": "string",
              "const": "WGS84"
            }
          },
          "additionalProperties": false
        },
        "resourceId": {
          "type": "string",
          "const": "vehicle:ugv1"
        },
        "timeWindow": {
          "type": "object",
          "required": ["earliestStart", "deadline"],
          "properties": {
            "deadline": {
              "type": "string",
              "format": "date-time"
            },
            "earliestStart": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "capabilityId": "embodied.area_patrol",
    "outputSchema": {
