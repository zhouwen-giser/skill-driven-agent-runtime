                "enum": ["completed", "failed", "canceled", "unavailable"]
              },
              "taskId": {
                "type": "string"
              },
              "skillId": {
                "type": "string"
              },
              "skillVersion": {
                "type": "integer",
                "minimum": 1
              },
              "missingEvidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "maxItems": 2
        },
        "resourceId": {
          "type": "string",
          "const": "vehicle:ugv1"
        },
        "trajectory": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["resourceId", "position"],
            "properties": {
              "position": {
                "type": "object",
                "required": ["x", "y"],
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "frame": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "resourceId": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "maxItems": 4096
        },
        "missingEffects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missingEvidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coveredSubregions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
