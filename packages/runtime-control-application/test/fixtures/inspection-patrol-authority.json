            "type": "object",
            "required": ["subregionId", "taskId", "report", "missingEvidence"],
            "properties": {
              "report": {
                "anyOf": [
                  {
                    "type": "object",
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "required": [
                      "version",
                      "completion",
                      "targetReportObservedAt",
                      "targetReportComplete",
                      "coverageState",
                      "findingCount",
                      "truncated",
                      "artifactRefs"
                    ],
                    "properties": {
                      "version": {
                        "type": "string",
                        "const": "1.0"
                      },
                      "truncated": {
                        "type": "boolean"
                      },
                      "completion": {
                        "enum": ["complete", "partial", "unavailable"],
                        "type": "string"
                      },
                      "artifactRefs": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["kind", "id", "revision"],
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "kind": {
                              "type": "string",
                              "const": "artifact"
                            },
                            "revision": {
                              "type": "integer",
                              "maximum": 9007199254740991,
                              "exclusiveMinimum": 0
                            }
                          },
                          "additionalProperties": false
                        },
                        "maxItems": 256
                      },
                      "findingCount": {
                        "type": "integer",
                        "maximum": 9007199254740991,
                        "minimum": 0
                      },
                      "coverageState": {
                        "enum": ["full", "partial", "none", "unknown"],
                        "type": "string"
                      },
                      "targetReportComplete": {
                        "type": "boolean"
                      },
                      "targetReportObservedAt": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "date-time",
                            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
