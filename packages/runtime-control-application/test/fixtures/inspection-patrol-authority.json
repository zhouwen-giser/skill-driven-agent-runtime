                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "maxItems": 256
        },
        "childTasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["taskId", "skillId", "skillVersion", "status", "missingEvidence"],
