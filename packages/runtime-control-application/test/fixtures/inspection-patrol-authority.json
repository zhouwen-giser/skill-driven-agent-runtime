        "missingSubregions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trajectorySourceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 256
        }
      },
      "additionalProperties": false
