# Suggested names for the SDAR adaptation; not already implemented settings.
SDAR_STORAGE_MODE=gowm-shared
GOWM_DATABASE_URL=
SDAR_SERVICE_KEY=example-sdar-campus
SDAR_ALLOWED_DEVICE_IDS=["TEST:device-A","TEST:device-B"]
# Explicit single-device deployments may configure this; otherwise leave empty.
SDAR_DEVICE_ID=
SDAR_GOWM_CONTRACT_DIR=contracts/gowm-shared-storage/current
# Existing Node Control management connection remains separately configured.
# No secrets and no real device endpoints in this file.
GOWM_BUSINESS_TEST_DATABASE_URL=
GOWM_BUSINESS_SMOKE_ENABLE=false
